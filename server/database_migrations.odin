package server

import "core:fmt"
import "core:strings"
import "shared:pg"

// Schema migrations. The database process runs them at startup (databaseMigrateSchema), before
// it reports readiness, and records each applied one in schema_migrations, so upgrading a server
// keeps every account, room, and message. The server never drops tables on its own: a database
// it cannot migrate stops startup with a [Startup] error and is left exactly as it was.
//
// DATABASE_MIGRATIONS is append-only. A migration that has merged is never edited, reordered,
// or removed, because databases in the field already recorded it; change the schema by
// appending the next version. Every migration runs inside the startup transaction, so a
// statement that cannot run in a transaction block (CREATE INDEX CONCURRENTLY, VACUUM, CREATE
// DATABASE, ...) is not supported. server/AGENTS.md describes how to add one.

// One schema change, applied at most once per database, in version order. checks holds the
// rows (`('name', condition)`, comma separated) that DATABASE_SCHEMA_VALIDATION_SQL adds for
// what this migration creates; the runner validates a list against its own migrations' checks,
// so a test can stop at an older version. Migration 1 leaves it empty: the baseline checks are
// DATABASE_BASELINE_SCHEMA_CHECKS.
DatabaseMigration :: struct {
	version: int,
	name:    string,
	sql:     string,
	checks:  string,
}

// What one startup did to the schema version.
DatabaseMigrationOutcome :: struct {
	// The version recorded before this start: 0 for an empty or an unversioned database.
	previousVersion: int,
	// The version recorded after this start: the newest migration.
	version:         int,
	// The database held HayChat tables from before migrations (v0.1.0-rc1 or a dev database)
	// and was adopted as version 1 without running a destructive step.
	adopted:         bool,
}

// Key of the transaction-scoped advisory lock taken before reading or changing the schema
// version, so two servers starting against one database migrate one after the other. Never
// change it: an old and a new server would then not exclude each other.
DATABASE_MIGRATION_LOCK_KEY :: i64(0x4861_7943_6861_7401)

// The runner's own bookkeeping, created before the migrations are read. Not a migration, so
// that every migration, the baseline included, is recorded in it.
DATABASE_SCHEMA_MIGRATIONS_CREATE_SQL ::
	"CREATE TABLE IF NOT EXISTS schema_migrations (" +
	"version INTEGER PRIMARY KEY, " +
	"name TEXT NOT NULL, " +
	"applied_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP)"

// The tables of the baseline schema. A database with any of them but no recorded version
// predates migrations and is adopted rather than treated as empty. Frozen with migration 1.
DATABASE_BASELINE_TABLES_SQL_LIST ::
	"'users', 'server_roles', 'user_server_roles', 'rooms', 'room_members', " +
	"'chat_messages', 'direct_messages'"

// Columns: the highest recorded version (0 when none), the number of recorded versions, the
// lowest recorded version (1 when none), and how many baseline tables the current schema holds.
DATABASE_MIGRATION_STATE_SQL ::
	"SELECT COALESCE(max(version), 0)::text, count(*)::text, COALESCE(min(version), 1)::text, " +
	"(SELECT count(*) FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace " +
	"WHERE n.nspname = current_schema() AND c.relkind IN ('r', 'p') " +
	"AND c.relname IN (" + DATABASE_BASELINE_TABLES_SQL_LIST + "))::text " +
	"FROM schema_migrations"

DATABASE_MIGRATION_LOCK_SQL :: "SELECT pg_advisory_xact_lock($1::bigint)"

DATABASE_MIGRATION_RECORD_SQL ::
	"INSERT INTO schema_migrations (version, name) VALUES ($1::integer, $2)"

// Appended to every refusal: what the operator can do about it.
DATABASE_MIGRATION_RECOVERY_HINT ::
	"The server rolled back and changed nothing; it never drops tables. Restore the backup " +
	"taken before the upgrade, or, for a throwaway database, reset it (see \"Upgrades\" in " +
	"the deploy guide, deploy/README.md)"

// Migration 1: the schema of v0.1.0-rc1, statement for statement. Every statement is
// idempotent, which is what lets the runner adopt databases created before migrations existed:
// it runs this again on them, which also upgrades a protocol 7 rooms table in place.
// Never edit it; append a migration instead.
DATABASE_MIGRATION_1_BASELINE_SQL ::
	"CREATE TABLE IF NOT EXISTS users (" +
	"id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " +
	"nickname VARCHAR(32) NOT NULL UNIQUE, " +
	"public_key BYTEA, " +
	"CHECK (char_length(nickname) BETWEEN 3 AND 32)); " +
	"ALTER TABLE users ADD COLUMN IF NOT EXISTS public_key BYTEA; " +
	"CREATE UNIQUE INDEX IF NOT EXISTS users_public_key_unique ON users (public_key); " +
	"CREATE TABLE IF NOT EXISTS server_roles (" +
	"id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " +
	"name VARCHAR(32) NOT NULL UNIQUE, " +
	"CHECK (char_length(name) BETWEEN 3 AND 32)); " +
	"CREATE TABLE IF NOT EXISTS user_server_roles (" +
	"user_id BIGINT NOT NULL REFERENCES users(id) ON DELETE CASCADE, " +
	"role_id BIGINT NOT NULL REFERENCES server_roles(id) ON DELETE CASCADE, " +
	"PRIMARY KEY (user_id, role_id)); " +
	"CREATE TABLE IF NOT EXISTS rooms (" +
	"id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " +
	"name VARCHAR(64) NOT NULL UNIQUE, " +
	"description VARCHAR(256) NOT NULL DEFAULT '', " +
	"created_by_user_id BIGINT REFERENCES users(id), " +
	"created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP, " +
	"CHECK (char_length(name) BETWEEN 1 AND 64)); " +
	// The server creates the default room itself, before any account exists, so a room may
	// have no creator. Protocol 7 databases have the NOT NULL; this upgrades them in place.
	"ALTER TABLE rooms ALTER COLUMN created_by_user_id DROP NOT NULL; " +
	"CREATE TABLE IF NOT EXISTS room_members (" +
	"room_id BIGINT NOT NULL REFERENCES rooms(id) ON DELETE CASCADE, " +
	"user_id BIGINT NOT NULL REFERENCES users(id) ON DELETE CASCADE, " +
	"joined_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP, " +
	"PRIMARY KEY (room_id, user_id)); " +
	"CREATE TABLE IF NOT EXISTS chat_messages (" +
	"id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " +
	"room_id BIGINT NOT NULL REFERENCES rooms(id) ON DELETE CASCADE, " +
	"sender_user_id BIGINT NOT NULL REFERENCES users(id), " +
	"content TEXT NOT NULL, " +
	"created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP, " +
	"CHECK (char_length(content) BETWEEN 1 AND 4000)); " +
	"CREATE TABLE IF NOT EXISTS direct_messages (" +
	"id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " +
	"sender_user_id BIGINT NOT NULL REFERENCES users(id) ON DELETE CASCADE, " +
	"recipient_user_id BIGINT NOT NULL REFERENCES users(id) ON DELETE CASCADE, " +
	"content TEXT NOT NULL, " +
	"created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP, " +
	"CHECK (char_length(content) BETWEEN 1 AND 4000), " +
	"CHECK (sender_user_id <> recipient_user_id)); " +
	"CREATE INDEX IF NOT EXISTS room_members_by_user_id ON room_members (user_id, room_id); " +
	"CREATE INDEX IF NOT EXISTS chat_messages_by_room_id_and_id " +
	"ON chat_messages (room_id, id DESC); " +
	// One index per direction: a conversation page reads both, and the conversation list
	// scans each user's sent and received messages.
	"CREATE INDEX IF NOT EXISTS direct_messages_by_sender_and_recipient " +
	"ON direct_messages (sender_user_id, recipient_user_id, id); " +
	"CREATE INDEX IF NOT EXISTS direct_messages_by_recipient_and_sender " +
	"ON direct_messages (recipient_user_id, sender_user_id, id);"

// Migration 2: per-user read markers for rooms and direct conversations (package B3), so unread
// counts survive a client restart and follow the account to every device.
//
// A marker is the newest message ID the user has read. Unread means (see also the list
// statements in database.odin and database_direct_messages.odin):
// - Rooms: messages from other users with an ID above the marker. Without a marker row, the
//   messages from others created after the user's room_members.joined_at, so a new account or
//   a newly created room starts with nothing unread.
// - Direct conversations: messages from the peer with an ID above the marker. Without a row,
//   every message from the peer.
// Counts are capped at common.UNREAD_COUNT_CAP.
//
// The backfill gives every existing room member a marker at the room's newest message and both
// sides of every existing conversation a marker at its newest message, so an upgraded rc1
// database starts with zero unread instead of every old message counting.
// Never edit it; append a migration instead.
DATABASE_MIGRATION_2_READ_MARKERS_SQL ::
	"CREATE TABLE room_read_markers (" +
	"user_id BIGINT NOT NULL REFERENCES users(id) ON DELETE CASCADE, " +
	"room_id BIGINT NOT NULL REFERENCES rooms(id) ON DELETE CASCADE, " +
	"last_read_message_id BIGINT NOT NULL CHECK (last_read_message_id >= 0), " +
	"updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP, " +
	"PRIMARY KEY (user_id, room_id)); " +
	"CREATE TABLE direct_read_markers (" +
	"user_id BIGINT NOT NULL REFERENCES users(id) ON DELETE CASCADE, " +
	"peer_user_id BIGINT NOT NULL REFERENCES users(id) ON DELETE CASCADE, " +
	"last_read_message_id BIGINT NOT NULL CHECK (last_read_message_id >= 0), " +
	"updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP, " +
	"PRIMARY KEY (user_id, peer_user_id), " +
	"CHECK (user_id <> peer_user_id)); " +
	// The primary keys serve every lookup by user. These serve the cascades: deleting a room
	// or an account finds its markers without scanning every marker.
	"CREATE INDEX room_read_markers_by_room_id ON room_read_markers (room_id); " +
	"CREATE INDEX direct_read_markers_by_peer_user_id ON direct_read_markers (peer_user_id); " +
	// A member without a marker counts the messages created after joined_at; this index keeps
	// that a range scan instead of a walk over the room's whole history.
	"CREATE INDEX chat_messages_by_room_id_and_created_at " +
	"ON chat_messages (room_id, created_at); " +
	"INSERT INTO room_read_markers (user_id, room_id, last_read_message_id) " +
	"SELECT rm.user_id, rm.room_id, newest.id FROM room_members rm " +
	"JOIN (SELECT room_id, max(id) AS id FROM chat_messages GROUP BY room_id) newest " +
	"ON newest.room_id = rm.room_id; " +
	"INSERT INTO direct_read_markers (user_id, peer_user_id, last_read_message_id) " +
	"SELECT side.user_id, side.peer_user_id, max(side.id) FROM (" +
	"SELECT sender_user_id AS user_id, recipient_user_id AS peer_user_id, id " +
	"FROM direct_messages UNION ALL " +
	"SELECT recipient_user_id, sender_user_id, id FROM direct_messages) side " +
	"GROUP BY side.user_id, side.peer_user_id;"

// What migration 2 adds, for DATABASE_SCHEMA_VALIDATION_SQL.
DATABASE_READ_MARKERS_CHECKS ::
	"('room_read_markers table', to_regclass('room_read_markers') IS NOT NULL), " +
	"('direct_read_markers table', to_regclass('direct_read_markers') IS NOT NULL), " +
	"('room_read_markers columns', (SELECT count(*) = 4 FROM information_schema.columns " +
	"WHERE table_schema = current_schema() AND table_name = 'room_read_markers' " +
	"AND column_name IN ('user_id', 'room_id', 'last_read_message_id', 'updated_at'))), " +
	"('direct_read_markers columns', (SELECT count(*) = 4 FROM information_schema.columns " +
	"WHERE table_schema = current_schema() AND table_name = 'direct_read_markers' " +
	"AND column_name IN ('user_id', 'peer_user_id', 'last_read_message_id', 'updated_at'))), " +
	"('room read markers primary key', EXISTS (SELECT 1 FROM pg_constraint " +
	"WHERE conrelid = to_regclass('room_read_markers') AND contype = 'p')), " +
	"('direct read markers primary key', EXISTS (SELECT 1 FROM pg_constraint " +
	"WHERE conrelid = to_regclass('direct_read_markers') AND contype = 'p')), " +
	"('room read markers cascade', (SELECT count(*) = 2 FROM pg_constraint " +
	"WHERE conrelid = to_regclass('room_read_markers') AND contype = 'f' " +
	"AND confdeltype = 'c')), " +
	"('direct read markers cascade', (SELECT count(*) = 2 FROM pg_constraint " +
	"WHERE conrelid = to_regclass('direct_read_markers') AND contype = 'f' " +
	"AND confdeltype = 'c')), " +
	"('direct read markers self check', EXISTS (SELECT 1 FROM pg_constraint " +
	"WHERE conrelid = to_regclass('direct_read_markers') AND contype = 'c' " +
	"AND pg_get_constraintdef(oid) LIKE '%user_id <> peer_user_id%')), " +
	"('room read markers room index', " +
	"to_regclass('room_read_markers_by_room_id') IS NOT NULL), " +
	"('direct read markers peer index', " +
	"to_regclass('direct_read_markers_by_peer_user_id') IS NOT NULL), " +
	"('chat messages created_at index', " +
	"to_regclass('chat_messages_by_room_id_and_created_at') IS NOT NULL)"

// Migration 3 (protocol 14): admin actions and room types.
//
// - users.nickname_locked: an admin renamed the account and locked the name, so a sign-in keeps
//   it whatever the client asks for.
// - users.banned_at, users.ban_reason: a banned account cannot sign in; banned_at is NULL for
//   every account that is not banned.
// - rooms.room_type: common.RoomType as a number, only Chat (1), Voice (2), and ChatAndVoice
//   (3). Every existing room becomes ChatAndVoice, which is what rooms did before.
//
// Columns are added with defaults, so every existing row keeps its data and gets the default.
// Never edit it; append a migration instead.
DATABASE_MIGRATION_3_ADMIN_SQL ::
	"ALTER TABLE users ADD COLUMN nickname_locked BOOLEAN NOT NULL DEFAULT false; " +
	"ALTER TABLE users ADD COLUMN banned_at TIMESTAMPTZ NULL; " +
	"ALTER TABLE users ADD COLUMN ban_reason VARCHAR(256) NOT NULL DEFAULT ''; " +
	"ALTER TABLE rooms ADD COLUMN room_type SMALLINT NOT NULL DEFAULT 3 " +
	"CONSTRAINT rooms_room_type_check CHECK (room_type IN (1, 2, 3));"

// What migration 3 adds, for DATABASE_SCHEMA_VALIDATION_SQL.
DATABASE_ADMIN_CHECKS ::
	"('users nickname_locked', EXISTS (SELECT 1 FROM information_schema.columns " +
	"WHERE table_schema = current_schema() AND table_name = 'users' " +
	"AND column_name = 'nickname_locked' AND data_type = 'boolean' AND is_nullable = 'NO')), " +
	"('users banned_at', EXISTS (SELECT 1 FROM information_schema.columns " +
	"WHERE table_schema = current_schema() AND table_name = 'users' " +
	"AND column_name = 'banned_at' AND data_type = 'timestamp with time zone' " +
	"AND is_nullable = 'YES')), " +
	"('users ban_reason', EXISTS (SELECT 1 FROM information_schema.columns " +
	"WHERE table_schema = current_schema() AND table_name = 'users' " +
	"AND column_name = 'ban_reason' AND data_type = 'character varying' " +
	"AND character_maximum_length = 256 AND is_nullable = 'NO')), " +
	"('rooms room_type', EXISTS (SELECT 1 FROM information_schema.columns " +
	"WHERE table_schema = current_schema() AND table_name = 'rooms' " +
	"AND column_name = 'room_type' AND data_type = 'smallint' AND is_nullable = 'NO')), " +
	"('rooms room type check', EXISTS (SELECT 1 FROM pg_constraint " +
	"WHERE conrelid = to_regclass('rooms') AND contype = 'c' " +
	"AND conname = 'rooms_room_type_check'))"

// Migration 4 (protocol 15): room access modes and history for new members.
//
// - rooms.access: common.RoomAccess as a number, Public (1), Member invite (2) or Admin invite
//   (3). Every existing room becomes Public, which is what rooms were before: every account a
//   member, new accounts joining.
// - rooms.history_visibility: common.RoomHistoryVisibility, From join (1) or Full (2), chosen
//   at creation and fixed afterwards. Existing rooms, and any row inserted without one (the
//   default room), get Full: Public rooms always read full history, so an existing room that
//   an admin later makes invite-only keeps showing its members what they could read before.
//
// Columns are added with defaults, so every existing row keeps its data. Never edit it; append
// a migration instead.
DATABASE_MIGRATION_4_ROOM_ACCESS_SQL ::
	"ALTER TABLE rooms ADD COLUMN access SMALLINT NOT NULL DEFAULT 1 " +
	"CONSTRAINT rooms_access_check CHECK (access IN (1, 2, 3)); " +
	"ALTER TABLE rooms ADD COLUMN history_visibility SMALLINT NOT NULL DEFAULT 2 " +
	"CONSTRAINT rooms_history_visibility_check CHECK (history_visibility IN (1, 2));"

// What migration 4 adds, for DATABASE_SCHEMA_VALIDATION_SQL.
DATABASE_ROOM_ACCESS_CHECKS ::
	"('rooms access', EXISTS (SELECT 1 FROM information_schema.columns " +
	"WHERE table_schema = current_schema() AND table_name = 'rooms' " +
	"AND column_name = 'access' AND data_type = 'smallint' AND is_nullable = 'NO')), " +
	"('rooms history_visibility', EXISTS (SELECT 1 FROM information_schema.columns " +
	"WHERE table_schema = current_schema() AND table_name = 'rooms' " +
	"AND column_name = 'history_visibility' AND data_type = 'smallint' " +
	"AND is_nullable = 'NO')), " +
	"('rooms access check', EXISTS (SELECT 1 FROM pg_constraint " +
	"WHERE conrelid = to_regclass('rooms') AND contype = 'c' " +
	"AND conname = 'rooms_access_check')), " +
	"('rooms history visibility check', EXISTS (SELECT 1 FROM pg_constraint " +
	"WHERE conrelid = to_regclass('rooms') AND contype = 'c' " +
	"AND conname = 'rooms_history_visibility_check'))"

// Migration 5 (protocol 16, e2ee-design.md 9.2): each account's published encryption key
// bundle (design 2.2, 3.1). One row per account; the identity key the bundle is signed by is
// users.public_key, so it is not stored twice.
//
// - encryption_public_key: the X25519 public key, 32 bytes.
// - created_at_unix: the bundle's createdAt (Unix seconds), part of the signed bytes.
// - signature: the identity key's Ed25519 signature over the bundle, 64 bytes.
// - updated_at: when the row last changed (a first publish or a replacement).
//
// A new table, so every existing row is untouched: accounts start without a bundle until their
// client publishes one. Never edit it; append a migration instead.
DATABASE_MIGRATION_5_USER_ENCRYPTION_KEYS_SQL ::
	"CREATE TABLE user_encryption_keys (" +
	"user_id BIGINT PRIMARY KEY REFERENCES users(id) ON DELETE CASCADE, " +
	"encryption_public_key BYTEA NOT NULL, " +
	"created_at_unix BIGINT NOT NULL, " +
	"signature BYTEA NOT NULL, " +
	"updated_at TIMESTAMPTZ NOT NULL DEFAULT now(), " +
	"CONSTRAINT user_encryption_keys_key_size CHECK (octet_length(encryption_public_key) = 32), " +
	"CONSTRAINT user_encryption_keys_signature_size CHECK (octet_length(signature) = 64), " +
	"CONSTRAINT user_encryption_keys_created_at CHECK (created_at_unix >= 0));"

// What migration 5 adds, for DATABASE_SCHEMA_VALIDATION_SQL.
DATABASE_USER_ENCRYPTION_KEYS_CHECKS ::
	"('user_encryption_keys table', to_regclass('user_encryption_keys') IS NOT NULL), " +
	"('user_encryption_keys columns', (SELECT count(*) = 5 FROM information_schema.columns " +
	"WHERE table_schema = current_schema() AND table_name = 'user_encryption_keys' " +
	"AND column_name IN ('user_id', 'encryption_public_key', 'created_at_unix', 'signature', " +
	"'updated_at'))), " +
	"('user encryption keys primary key', EXISTS (SELECT 1 FROM pg_constraint " +
	"WHERE conrelid = to_regclass('user_encryption_keys') AND contype = 'p')), " +
	"('user encryption keys cascade', EXISTS (SELECT 1 FROM pg_constraint " +
	"WHERE conrelid = to_regclass('user_encryption_keys') AND contype = 'f' " +
	"AND confdeltype = 'c')), " +
	"('user encryption keys size checks', (SELECT count(*) = 3 FROM pg_constraint " +
	"WHERE conrelid = to_regclass('user_encryption_keys') AND contype = 'c' " +
	"AND conname IN ('user_encryption_keys_key_size', 'user_encryption_keys_signature_size', " +
	"'user_encryption_keys_created_at')))"

// Migration 6 (protocol 17, e2ee-design.md 4.5, 4.6, 9.2): encrypted direct messages and the
// signed plaintext fallback.
//
// - content may be empty: an encrypted message stores its envelope and an empty content. The
//   baseline's unnamed check on content's length is dropped (found by its definition, since
//   its name depends on how the table was created) and replaced by
//   direct_messages_content_or_envelope: exactly one of a 1..4000 character content or a
//   1..8192 byte envelope (common.SEALED_ENVELOPE_MAX_BYTES).
// - client_message_id: the sender's 16-byte ID for the message, bound into the envelope's AAD
//   or the fallback's signature. NULL for messages from before protocol 17; every message
//   stored since has one, and direct_messages_sender_client_message_id makes it unique per
//   sender, so a replayed message is refused.
// - envelope: the sealed envelope, byte for byte as the sender sent it.
// - signature: the sender's Ed25519 signature over a plaintext fallback message (64 bytes);
//   NULL for encrypted messages and for messages from before protocol 17.
//
// Every existing row is plaintext without an ID or a signature, which every new check
// accepts, so no row changes. Never edit it; append a migration instead.
DATABASE_MIGRATION_6_ENCRYPTED_DIRECT_MESSAGES_SQL ::
	"DO $$ DECLARE constraint_name text; BEGIN " +
	"FOR constraint_name IN SELECT conname FROM pg_constraint " +
	"WHERE conrelid = to_regclass('direct_messages') AND contype = 'c' " +
	"AND pg_get_constraintdef(oid) LIKE '%char_length(content)%' LOOP " +
	"EXECUTE format('ALTER TABLE direct_messages DROP CONSTRAINT %I', constraint_name); " +
	"END LOOP; END $$; " +
	"ALTER TABLE direct_messages ADD COLUMN client_message_id BYTEA NULL, " +
	"ADD COLUMN envelope BYTEA NULL, ADD COLUMN signature BYTEA NULL; " +
	"ALTER TABLE direct_messages ADD CONSTRAINT direct_messages_content_or_envelope CHECK (" +
	"(envelope IS NULL AND char_length(content) BETWEEN 1 AND 4000) OR " +
	"(envelope IS NOT NULL AND content = '' AND octet_length(envelope) BETWEEN 1 AND 8192)), " +
	"ADD CONSTRAINT direct_messages_envelope_size " +
	"CHECK (octet_length(envelope) <= 8192), " +
	"ADD CONSTRAINT direct_messages_client_message_id_size " +
	"CHECK (octet_length(client_message_id) = 16), " +
	"ADD CONSTRAINT direct_messages_signature_size CHECK (octet_length(signature) = 64), " +
	"ADD CONSTRAINT direct_messages_envelope_has_id " +
	"CHECK (envelope IS NULL OR client_message_id IS NOT NULL), " +
	"ADD CONSTRAINT direct_messages_signature_on_plaintext CHECK (signature IS NULL OR " +
	"(envelope IS NULL AND client_message_id IS NOT NULL)); " +
	"CREATE UNIQUE INDEX direct_messages_sender_client_message_id " +
	"ON direct_messages (sender_user_id, client_message_id) " +
	"WHERE client_message_id IS NOT NULL;"

// What migration 6 adds, for DATABASE_SCHEMA_VALIDATION_SQL.
DATABASE_ENCRYPTED_DIRECT_MESSAGES_CHECKS ::
	"('direct_messages e2ee columns', (SELECT count(*) = 3 FROM information_schema.columns " +
	"WHERE table_schema = current_schema() AND table_name = 'direct_messages' " +
	"AND column_name IN ('client_message_id', 'envelope', 'signature') " +
	"AND data_type = 'bytea' AND is_nullable = 'YES')), " +
	"('direct messages e2ee checks', (SELECT count(*) = 6 FROM pg_constraint " +
	"WHERE conrelid = to_regclass('direct_messages') AND contype = 'c' " +
	"AND conname IN ('direct_messages_content_or_envelope', 'direct_messages_envelope_size', " +
	"'direct_messages_client_message_id_size', 'direct_messages_signature_size', " +
	"'direct_messages_envelope_has_id', 'direct_messages_signature_on_plaintext'))), " +
	"('direct messages content length check dropped', NOT EXISTS (SELECT 1 FROM pg_constraint " +
	"WHERE conrelid = to_regclass('direct_messages') AND contype = 'c' " +
	"AND conname <> 'direct_messages_content_or_envelope' " +
	"AND pg_get_constraintdef(oid) LIKE '%char_length(content)%')), " +
	"('direct messages client message id index', " +
	"to_regclass('direct_messages_sender_client_message_id') IS NOT NULL)"

// Migration 7 (protocol 18, e2ee-design.md 6.1, 6.2, 9.2): encrypted rooms and their signed
// member log.
//
// - rooms.encrypted: fixed at creation (an encrypted room is never Public, rooms_encrypted_access).
// - rooms.log_version: the version of the newest stored log entry, 0 before the room's Create
//   entry and for unencrypted rooms (rooms_log_version_check).
// - room_log_entries: each entry byte for byte (common/e2ee.odin's RoomLogEntry layout), one
//   row per version. The primary key (room_id, version) makes a second entry at a version
//   impossible, so concurrent appends cannot both win; the size check is
//   common.ROOM_LOG_ENTRY_MAX_BYTES (4208).
// - room_log_managers: the managers the log names after its newest entry, kept in the same
//   transaction as each entry so a manager who is not a member can fetch the log without the
//   server replaying it. It is derived data; the log is the source.
//
// Every existing room stays unencrypted with version 0, and both tables start empty. E4b adds
// room_key_envelopes and the sealed chat_messages columns in its own migration. Never edit it;
// append a migration instead.
DATABASE_MIGRATION_7_ENCRYPTED_ROOM_LOG_SQL ::
	"ALTER TABLE rooms ADD COLUMN encrypted BOOLEAN NOT NULL DEFAULT false, " +
	"ADD COLUMN log_version BIGINT NOT NULL DEFAULT 0; " +
	"ALTER TABLE rooms ADD CONSTRAINT rooms_encrypted_access " +
	"CHECK (NOT encrypted OR access IN (2, 3)), " +
	"ADD CONSTRAINT rooms_log_version_check " +
	"CHECK (log_version >= 0 AND (encrypted OR log_version = 0)); " +
	"CREATE TABLE room_log_entries (" +
	"room_id BIGINT NOT NULL REFERENCES rooms(id) ON DELETE CASCADE, " +
	"version BIGINT NOT NULL, " +
	"entry BYTEA NOT NULL, " +
	"created_at TIMESTAMPTZ NOT NULL DEFAULT now(), " +
	"PRIMARY KEY (room_id, version), " +
	"CONSTRAINT room_log_entries_version_check CHECK (version >= 1), " +
	"CONSTRAINT room_log_entries_entry_size " +
	"CHECK (octet_length(entry) BETWEEN 1 AND 4208)); " +
	"CREATE TABLE room_log_managers (" +
	"room_id BIGINT NOT NULL REFERENCES rooms(id) ON DELETE CASCADE, " +
	"user_id BIGINT NOT NULL REFERENCES users(id) ON DELETE CASCADE, " +
	"PRIMARY KEY (room_id, user_id)); " +
	"CREATE INDEX room_log_managers_by_user_id ON room_log_managers (user_id, room_id);"

// What migration 7 adds, for DATABASE_SCHEMA_VALIDATION_SQL.
DATABASE_ENCRYPTED_ROOM_LOG_CHECKS ::
	"('rooms encrypted', EXISTS (SELECT 1 FROM information_schema.columns " +
	"WHERE table_schema = current_schema() AND table_name = 'rooms' " +
	"AND column_name = 'encrypted' AND data_type = 'boolean' AND is_nullable = 'NO')), " +
	"('rooms log_version', EXISTS (SELECT 1 FROM information_schema.columns " +
	"WHERE table_schema = current_schema() AND table_name = 'rooms' " +
	"AND column_name = 'log_version' AND data_type = 'bigint' AND is_nullable = 'NO')), " +
	"('rooms encryption checks', (SELECT count(*) = 2 FROM pg_constraint " +
	"WHERE conrelid = to_regclass('rooms') AND contype = 'c' " +
	"AND conname IN ('rooms_encrypted_access', 'rooms_log_version_check'))), " +
	"('room_log_entries table', to_regclass('room_log_entries') IS NOT NULL), " +
	"('room_log_entries columns', (SELECT count(*) = 4 FROM information_schema.columns " +
	"WHERE table_schema = current_schema() AND table_name = 'room_log_entries' " +
	"AND column_name IN ('room_id', 'version', 'entry', 'created_at'))), " +
	"('room log entries primary key', EXISTS (SELECT 1 FROM pg_constraint " +
	"WHERE conrelid = to_regclass('room_log_entries') AND contype = 'p')), " +
	"('room log entries checks', (SELECT count(*) = 2 FROM pg_constraint " +
	"WHERE conrelid = to_regclass('room_log_entries') AND contype = 'c' " +
	"AND conname IN ('room_log_entries_version_check', 'room_log_entries_entry_size'))), " +
	"('room log entries cascade', EXISTS (SELECT 1 FROM pg_constraint " +
	"WHERE conrelid = to_regclass('room_log_entries') AND contype = 'f' " +
	"AND confdeltype = 'c')), " +
	"('room_log_managers table', to_regclass('room_log_managers') IS NOT NULL), " +
	"('room log managers primary key', EXISTS (SELECT 1 FROM pg_constraint " +
	"WHERE conrelid = to_regclass('room_log_managers') AND contype = 'p')), " +
	"('room log managers cascades', (SELECT count(*) = 2 FROM pg_constraint " +
	"WHERE conrelid = to_regclass('room_log_managers') AND contype = 'f' " +
	"AND confdeltype = 'c')), " +
	"('room log managers index', to_regclass('room_log_managers_by_user_id') IS NOT NULL)"

// Migration 8 (protocol 19, e2ee-design.md 6.3-6.5, 9.2): sender chains in encrypted rooms.
//
// - chat_messages: content may be empty for a sealed message. client_message_id (16 bytes),
//   sealed (the SealedRoomMessage byte for byte, 1..8192 bytes) and the chain position the
//   server read from it (epoch, chain_id, chain_index), all NULL for plaintext messages.
//   chat_messages_content_or_sealed: exactly one of a 1..4000 character content or a sealed
//   message with content ''; chat_messages_sealed_fields: a sealed row has every one of the
//   other four. chat_messages_sender_client_message_id refuses a reused client message ID per
//   sender and chat_messages_sender_chain_index a reused chain index, so an index is never
//   stored twice (design 6.3).
// - room_key_envelopes: one SenderKey envelope per row, byte for byte, with the user IDs its
//   wraps name (recipient_user_ids, so a fetch returns only envelopes with a wrap for the
//   requester), indexed by (room_id, epoch) and by chain.
//
// The baseline's unnamed content check is dropped by its definition, as migration 6 did for
// direct_messages. Every existing row is plaintext, which the new checks accept, so no row
// changes. Never edit it; append a migration instead.
DATABASE_MIGRATION_8_ROOM_SENDER_CHAINS_SQL ::
	"DO $$ DECLARE constraint_name text; BEGIN " +
	"FOR constraint_name IN SELECT conname FROM pg_constraint " +
	"WHERE conrelid = to_regclass('chat_messages') AND contype = 'c' " +
	"AND pg_get_constraintdef(oid) LIKE '%char_length(content)%' LOOP " +
	"EXECUTE format('ALTER TABLE chat_messages DROP CONSTRAINT %I', constraint_name); " +
	"END LOOP; END $$; " +
	"ALTER TABLE chat_messages ADD COLUMN client_message_id BYTEA NULL, " +
	"ADD COLUMN sealed BYTEA NULL, ADD COLUMN epoch BIGINT NULL, " +
	"ADD COLUMN chain_id BYTEA NULL, ADD COLUMN chain_index INTEGER NULL; " +
	"ALTER TABLE chat_messages ADD CONSTRAINT chat_messages_content_or_sealed CHECK (" +
	"(sealed IS NULL AND char_length(content) BETWEEN 1 AND 4000) OR " +
	"(sealed IS NOT NULL AND content = '' AND octet_length(sealed) BETWEEN 1 AND 8192)), " +
	"ADD CONSTRAINT chat_messages_sealed_fields CHECK (" +
	"(sealed IS NULL AND client_message_id IS NULL AND epoch IS NULL AND chain_id IS NULL " +
	"AND chain_index IS NULL) OR (sealed IS NOT NULL AND client_message_id IS NOT NULL " +
	"AND epoch IS NOT NULL AND chain_id IS NOT NULL AND chain_index IS NOT NULL)), " +
	"ADD CONSTRAINT chat_messages_client_message_id_size " +
	"CHECK (octet_length(client_message_id) = 16), " +
	"ADD CONSTRAINT chat_messages_chain_id_size CHECK (octet_length(chain_id) = 16), " +
	"ADD CONSTRAINT chat_messages_chain_position_check " +
	"CHECK (epoch >= 1 AND chain_index BETWEEN 0 AND 999); " +
	"CREATE UNIQUE INDEX chat_messages_sender_client_message_id " +
	"ON chat_messages (sender_user_id, client_message_id) WHERE client_message_id IS NOT NULL; " +
	"CREATE UNIQUE INDEX chat_messages_sender_chain_index " +
	"ON chat_messages (sender_user_id, chain_id, chain_index) WHERE chain_id IS NOT NULL; " +
	"CREATE TABLE room_key_envelopes (" +
	"id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " +
	"room_id BIGINT NOT NULL REFERENCES rooms(id) ON DELETE CASCADE, " +
	"epoch BIGINT NOT NULL, " +
	"sender_user_id BIGINT NOT NULL REFERENCES users(id) ON DELETE CASCADE, " +
	"chain_id BYTEA NOT NULL, " +
	"recipient_user_ids BIGINT[] NOT NULL, " +
	"envelope BYTEA NOT NULL, " +
	"created_at TIMESTAMPTZ NOT NULL DEFAULT now(), " +
	"CONSTRAINT room_key_envelopes_epoch_check CHECK (epoch >= 1), " +
	"CONSTRAINT room_key_envelopes_chain_id_size CHECK (octet_length(chain_id) = 16), " +
	"CONSTRAINT room_key_envelopes_recipients_check " +
	"CHECK (cardinality(recipient_user_ids) BETWEEN 1 AND 100), " +
	"CONSTRAINT room_key_envelopes_envelope_size " +
	"CHECK (octet_length(envelope) BETWEEN 1 AND 8192)); " +
	"CREATE INDEX room_key_envelopes_by_room_id_and_epoch " +
	"ON room_key_envelopes (room_id, epoch); " +
	"CREATE INDEX room_key_envelopes_by_chain " +
	"ON room_key_envelopes (room_id, sender_user_id, chain_id);"

// What migration 8 adds, for DATABASE_SCHEMA_VALIDATION_SQL.
DATABASE_ROOM_SENDER_CHAINS_CHECKS ::
	"('chat_messages e2ee columns', (SELECT count(*) = 5 FROM information_schema.columns " +
	"WHERE table_schema = current_schema() AND table_name = 'chat_messages' " +
	"AND column_name IN ('client_message_id', 'sealed', 'epoch', 'chain_id', 'chain_index') " +
	"AND is_nullable = 'YES')), " +
	"('chat messages e2ee checks', (SELECT count(*) = 5 FROM pg_constraint " +
	"WHERE conrelid = to_regclass('chat_messages') AND contype = 'c' " +
	"AND conname IN ('chat_messages_content_or_sealed', 'chat_messages_sealed_fields', " +
	"'chat_messages_client_message_id_size', 'chat_messages_chain_id_size', " +
	"'chat_messages_chain_position_check'))), " +
	"('chat messages content length check dropped', NOT EXISTS (SELECT 1 FROM pg_constraint " +
	"WHERE conrelid = to_regclass('chat_messages') AND contype = 'c' " +
	"AND conname <> 'chat_messages_content_or_sealed' " +
	"AND pg_get_constraintdef(oid) LIKE '%char_length(content)%')), " +
	"('chat messages client message id index', " +
	"to_regclass('chat_messages_sender_client_message_id') IS NOT NULL), " +
	"('chat messages chain index index', " +
	"to_regclass('chat_messages_sender_chain_index') IS NOT NULL), " +
	"('room_key_envelopes table', to_regclass('room_key_envelopes') IS NOT NULL), " +
	"('room_key_envelopes columns', (SELECT count(*) = 8 FROM information_schema.columns " +
	"WHERE table_schema = current_schema() AND table_name = 'room_key_envelopes' " +
	"AND column_name IN ('id', 'room_id', 'epoch', 'sender_user_id', 'chain_id', " +
	"'recipient_user_ids', 'envelope', 'created_at'))), " +
	"('room key envelopes checks', (SELECT count(*) = 4 FROM pg_constraint " +
	"WHERE conrelid = to_regclass('room_key_envelopes') AND contype = 'c' " +
	"AND conname IN ('room_key_envelopes_epoch_check', 'room_key_envelopes_chain_id_size', " +
	"'room_key_envelopes_recipients_check', 'room_key_envelopes_envelope_size'))), " +
	"('room key envelopes cascades', (SELECT count(*) = 2 FROM pg_constraint " +
	"WHERE conrelid = to_regclass('room_key_envelopes') AND contype = 'f' " +
	"AND confdeltype = 'c')), " +
	"('room key envelopes epoch index', " +
	"to_regclass('room_key_envelopes_by_room_id_and_epoch') IS NOT NULL), " +
	"('room key envelopes chain index', " +
	"to_regclass('room_key_envelopes_by_chain') IS NOT NULL)"

// Migration 9 (protocol 20, e2ee-design.md 6.6): Full history in encrypted rooms.
//
// - room_key_envelopes.forwarder_user_id: NULL for a SenderKey envelope (sealed by
//   sender_user_id, the chain's sender), and the forwarding account for a RoomKeyForward
//   envelope of sender_user_id's chain. room_key_envelopes_forward_check: a forwarder is a
//   positive ID other than the sender, and a forward has exactly one recipient.
//
// The column has no foreign key: migration 8's checks count the table's cascading keys (two),
// and the server never deletes accounts. A forward whose forwarder was deleted by hand stays
// valid, because clients verify it against the identity the room's member log names. Every
// existing row is a SenderKey envelope and keeps NULL. Never edit it; append a migration
// instead.
DATABASE_MIGRATION_9_ROOM_KEY_FORWARDS_SQL ::
	"ALTER TABLE room_key_envelopes ADD COLUMN forwarder_user_id BIGINT NULL; " +
	"ALTER TABLE room_key_envelopes ADD CONSTRAINT room_key_envelopes_forward_check " +
	"CHECK (forwarder_user_id IS NULL OR (forwarder_user_id >= 1 " +
	"AND forwarder_user_id <> sender_user_id AND cardinality(recipient_user_ids) = 1));"

// What migration 9 adds, for DATABASE_SCHEMA_VALIDATION_SQL.
DATABASE_ROOM_KEY_FORWARDS_CHECKS ::
	"('room_key_envelopes forwarder_user_id', EXISTS (SELECT 1 FROM information_schema.columns " +
	"WHERE table_schema = current_schema() AND table_name = 'room_key_envelopes' " +
	"AND column_name = 'forwarder_user_id' AND data_type = 'bigint' AND is_nullable = 'YES')), " +
	"('room key envelopes forward check', EXISTS (SELECT 1 FROM pg_constraint " +
	"WHERE conrelid = to_regclass('room_key_envelopes') AND contype = 'c' " +
	"AND conname = 'room_key_envelopes_forward_check'))"

// Migration 10 (protocol 22, #82, #90): every message is signed by its sender.
//
// - Unsigned rows are deleted: every plaintext room message (none had a signature before
//   protocol 22) and every direct message from before protocol 17 (plaintext without a
//   signature). Clients never show a message without its sender's valid signature, so these
//   rows could never be read again; deleting them keeps the server's unread counts and
//   conversation list in step with what clients show. Read markers are message IDs and stay
//   valid.
// - chat_messages.signature: the sender's Ed25519 signature over a plaintext message
//   (signPlaintextRoomMessage, 64 bytes, chat_messages_signature_size); NULL for a sealed one,
//   which carries its own. chat_messages_sealed_fields is replaced under the same name: a
//   plaintext row has a client message ID and a signature and no chain fields, a sealed row a
//   client message ID, its chain fields and no signature column. The unique index on
//   (sender_user_id, client_message_id) now refuses a reused ID for plaintext too.
// - direct_messages_signed: a direct message is an envelope or carries a signature.
//
// Never edit it; append a migration instead.
DATABASE_MIGRATION_10_SIGNED_MESSAGES_SQL ::
	"DELETE FROM chat_messages WHERE sealed IS NULL; " +
	"DELETE FROM direct_messages WHERE envelope IS NULL AND signature IS NULL; " +
	"ALTER TABLE chat_messages ADD COLUMN signature BYTEA NULL; " +
	"ALTER TABLE chat_messages DROP CONSTRAINT chat_messages_sealed_fields; " +
	"ALTER TABLE chat_messages ADD CONSTRAINT chat_messages_sealed_fields CHECK (" +
	"(sealed IS NULL AND client_message_id IS NOT NULL AND signature IS NOT NULL " +
	"AND epoch IS NULL AND chain_id IS NULL AND chain_index IS NULL) OR " +
	"(sealed IS NOT NULL AND client_message_id IS NOT NULL AND signature IS NULL " +
	"AND epoch IS NOT NULL AND chain_id IS NOT NULL AND chain_index IS NOT NULL)), " +
	"ADD CONSTRAINT chat_messages_signature_size CHECK (octet_length(signature) = 64); " +
	"ALTER TABLE direct_messages ADD CONSTRAINT direct_messages_signed " +
	"CHECK (envelope IS NOT NULL OR signature IS NOT NULL);"

// What migration 10 adds, for DATABASE_SCHEMA_VALIDATION_SQL.
DATABASE_SIGNED_MESSAGES_CHECKS ::
	"('chat_messages signature', EXISTS (SELECT 1 FROM information_schema.columns " +
	"WHERE table_schema = current_schema() AND table_name = 'chat_messages' " +
	"AND column_name = 'signature' AND data_type = 'bytea' AND is_nullable = 'YES')), " +
	"('chat messages signed fields', EXISTS (SELECT 1 FROM pg_constraint " +
	"WHERE conrelid = to_regclass('chat_messages') AND contype = 'c' " +
	"AND conname = 'chat_messages_sealed_fields' " +
	"AND pg_get_constraintdef(oid) LIKE '%signature IS NOT NULL%')), " +
	"('chat messages signature size', EXISTS (SELECT 1 FROM pg_constraint " +
	"WHERE conrelid = to_regclass('chat_messages') AND contype = 'c' " +
	"AND conname = 'chat_messages_signature_size')), " +
	"('direct messages signed', EXISTS (SELECT 1 FROM pg_constraint " +
	"WHERE conrelid = to_regclass('direct_messages') AND contype = 'c' " +
	"AND conname = 'direct_messages_signed'))"

// Migration 11 (protocol 23, #95): roles and server permissions.
//
// - server_roles.permissions: the role's common.ServerPermissions as a BIGINT mask (bit N is
//   ServerPermission N). Existing roles get none.
// - server_roles.builtin: true only for admin (server_roles_builtin_admin), at most one row
//   (server_roles_one_builtin). The built-in role cannot be renamed, deleted or reduced.
// - server_roles.position: display order only, ascending.
//
// The admin role is created when it is missing, so every database has it from now on, and gets
// every permission known today (511, ManageRooms .. RenameUsers); the server also treats it as
// holding every permission whatever the column says (database_roles.odin). Other existing roles
// keep their holders and are ordered by ID.
//
// Never edit it; append a migration instead.
DATABASE_MIGRATION_11_ROLES_SQL ::
	"ALTER TABLE server_roles ADD COLUMN permissions BIGINT NOT NULL DEFAULT 0, " +
	"ADD COLUMN builtin BOOLEAN NOT NULL DEFAULT false, " +
	"ADD COLUMN position INTEGER NOT NULL DEFAULT 0; " +
	"INSERT INTO server_roles (name) SELECT 'admin' " +
	"WHERE NOT EXISTS (SELECT 1 FROM server_roles WHERE name = 'admin'); " +
	"UPDATE server_roles SET builtin = true, permissions = 511, position = 0 " +
	"WHERE name = 'admin'; " +
	"UPDATE server_roles SET position = id WHERE NOT builtin; " +
	"ALTER TABLE server_roles ADD CONSTRAINT server_roles_builtin_admin " +
	"CHECK (NOT builtin OR name = 'admin'), " +
	"ADD CONSTRAINT server_roles_position_check CHECK (position >= 0); " +
	"CREATE UNIQUE INDEX server_roles_one_builtin ON server_roles (builtin) WHERE builtin;"

// What migration 11 adds, for DATABASE_SCHEMA_VALIDATION_SQL.
DATABASE_ROLES_CHECKS ::
	"('server_roles permissions', EXISTS (SELECT 1 FROM information_schema.columns " +
	"WHERE table_schema = current_schema() AND table_name = 'server_roles' " +
	"AND column_name = 'permissions' AND data_type = 'bigint' AND is_nullable = 'NO')), " +
	"('server_roles builtin', EXISTS (SELECT 1 FROM information_schema.columns " +
	"WHERE table_schema = current_schema() AND table_name = 'server_roles' " +
	"AND column_name = 'builtin' AND data_type = 'boolean' AND is_nullable = 'NO')), " +
	"('server_roles position', EXISTS (SELECT 1 FROM information_schema.columns " +
	"WHERE table_schema = current_schema() AND table_name = 'server_roles' " +
	"AND column_name = 'position' AND data_type = 'integer' AND is_nullable = 'NO')), " +
	"('server roles builtin admin', EXISTS (SELECT 1 FROM pg_constraint " +
	"WHERE conrelid = to_regclass('server_roles') AND contype = 'c' " +
	"AND conname = 'server_roles_builtin_admin')), " +
	"('server roles position check', EXISTS (SELECT 1 FROM pg_constraint " +
	"WHERE conrelid = to_regclass('server_roles') AND contype = 'c' " +
	"AND conname = 'server_roles_position_check')), " +
	"('server roles one builtin', to_regclass('server_roles_one_builtin') IS NOT NULL)"

// The ordered, append-only migration list. Versions start at 1 and increase by one.
DATABASE_MIGRATIONS := [?]DatabaseMigration {
	{version = 1, name = "baseline", sql = DATABASE_MIGRATION_1_BASELINE_SQL},
	{
		version = 2,
		name = "read markers",
		sql = DATABASE_MIGRATION_2_READ_MARKERS_SQL,
		checks = DATABASE_READ_MARKERS_CHECKS,
	},
	{
		version = 3,
		name = "admin",
		sql = DATABASE_MIGRATION_3_ADMIN_SQL,
		checks = DATABASE_ADMIN_CHECKS,
	},
	{
		version = 4,
		name = "room access",
		sql = DATABASE_MIGRATION_4_ROOM_ACCESS_SQL,
		checks = DATABASE_ROOM_ACCESS_CHECKS,
	},
	{
		version = 5,
		name = "user encryption keys",
		sql = DATABASE_MIGRATION_5_USER_ENCRYPTION_KEYS_SQL,
		checks = DATABASE_USER_ENCRYPTION_KEYS_CHECKS,
	},
	{
		version = 6,
		name = "encrypted direct messages",
		sql = DATABASE_MIGRATION_6_ENCRYPTED_DIRECT_MESSAGES_SQL,
		checks = DATABASE_ENCRYPTED_DIRECT_MESSAGES_CHECKS,
	},
	{
		version = 7,
		name = "encrypted room log",
		sql = DATABASE_MIGRATION_7_ENCRYPTED_ROOM_LOG_SQL,
		checks = DATABASE_ENCRYPTED_ROOM_LOG_CHECKS,
	},
	{
		version = 8,
		name = "room sender chains",
		sql = DATABASE_MIGRATION_8_ROOM_SENDER_CHAINS_SQL,
		checks = DATABASE_ROOM_SENDER_CHAINS_CHECKS,
	},
	{
		version = 9,
		name = "room key forwards",
		sql = DATABASE_MIGRATION_9_ROOM_KEY_FORWARDS_SQL,
		checks = DATABASE_ROOM_KEY_FORWARDS_CHECKS,
	},
	{
		version = 10,
		name = "signed messages",
		sql = DATABASE_MIGRATION_10_SIGNED_MESSAGES_SQL,
		checks = DATABASE_SIGNED_MESSAGES_CHECKS,
	},
	{
		version = 11,
		name = "roles",
		sql = DATABASE_MIGRATION_11_ROLES_SQL,
		checks = DATABASE_ROLES_CHECKS,
	},
}

DATABASE_SCHEMA_VALIDATION_PREFIX :: "WITH checks(name, valid) AS (VALUES "
DATABASE_SCHEMA_VALIDATION_SUFFIX ::
	") SELECT COALESCE(string_agg(name, ', ' ORDER BY name), '') FROM checks WHERE NOT valid;"

// The objects of the version 1 schema. Names resolve through search_path and columns are read
// from current_schema(), so validation works in any schema: production uses public, the SQL
// tests a schema of their own. Frozen with migration 1: adoption checks an unversioned
// database against exactly this.
DATABASE_BASELINE_SCHEMA_CHECKS ::
	"('users table', to_regclass('users') IS NOT NULL), " +
	"('server_roles table', to_regclass('server_roles') IS NOT NULL), " +
	"('user_server_roles table', to_regclass('user_server_roles') IS NOT NULL), " +
	"('rooms table', to_regclass('rooms') IS NOT NULL), " +
	"('room_members table', to_regclass('room_members') IS NOT NULL), " +
	"('chat_messages table', to_regclass('chat_messages') IS NOT NULL), " +
	"('direct_messages table', to_regclass('direct_messages') IS NOT NULL), " +
	"('users columns', (SELECT count(*) = 3 FROM information_schema.columns " +
	"WHERE table_schema = current_schema() AND table_name = 'users' " +
	"AND column_name IN ('id', 'nickname', 'public_key'))), " +
	"('users identity id', EXISTS (SELECT 1 FROM information_schema.columns " +
	"WHERE table_schema = current_schema() AND table_name = 'users' AND column_name = 'id' " +
	"AND data_type = 'bigint' AND is_nullable = 'NO' AND is_identity = 'YES')), " +
	"('users nickname', EXISTS (SELECT 1 FROM information_schema.columns " +
	"WHERE table_schema = current_schema() AND table_name = 'users' " +
	"AND column_name = 'nickname' AND data_type = 'character varying' " +
	"AND character_maximum_length = 32 AND is_nullable = 'NO')), " +
	"('users public key', EXISTS (SELECT 1 FROM information_schema.columns " +
	"WHERE table_schema = current_schema() AND table_name = 'users' " +
	"AND column_name = 'public_key' AND data_type = 'bytea' AND is_nullable = 'YES')), " +
	"('server_roles columns', (SELECT count(*) = 2 FROM information_schema.columns " +
	"WHERE table_schema = current_schema() AND table_name = 'server_roles' " +
	"AND column_name IN ('id', 'name'))), " +
	"('rooms columns', (SELECT count(*) = 5 FROM information_schema.columns " +
	"WHERE table_schema = current_schema() AND table_name = 'rooms' AND column_name IN " +
	"('id', 'name', 'description', 'created_by_user_id', 'created_at'))), " +
	"('rooms creator nullable', EXISTS (SELECT 1 FROM information_schema.columns " +
	"WHERE table_schema = current_schema() AND table_name = 'rooms' " +
	"AND column_name = 'created_by_user_id' AND is_nullable = 'YES')), " +
	"('room_members columns', (SELECT count(*) = 3 FROM information_schema.columns " +
	"WHERE table_schema = current_schema() AND table_name = 'room_members' AND column_name IN " +
	"('room_id', 'user_id', 'joined_at'))), " +
	"('chat_messages columns', (SELECT count(*) = 5 FROM information_schema.columns " +
	"WHERE table_schema = current_schema() AND table_name = 'chat_messages' AND column_name IN " +
	"('id', 'room_id', 'sender_user_id', 'content', 'created_at'))), " +
	"('direct_messages columns', (SELECT count(*) = 5 FROM information_schema.columns " +
	"WHERE table_schema = current_schema() AND table_name = 'direct_messages' " +
	"AND column_name IN ('id', 'sender_user_id', 'recipient_user_id', 'content', " +
	"'created_at'))), " +
	"('user_server_roles columns', (SELECT count(*) = 2 FROM information_schema.columns " +
	"WHERE table_schema = current_schema() AND table_name = 'user_server_roles' " +
	"AND column_name IN ('user_id', 'role_id'))), " +
	"('users public key index', to_regclass('users_public_key_unique') IS NOT NULL), " +
	"('room members index', to_regclass('room_members_by_user_id') IS NOT NULL), " +
	"('chat messages index', to_regclass('chat_messages_by_room_id_and_id') IS NOT NULL), " +
	"('direct messages sender index', " +
	"to_regclass('direct_messages_by_sender_and_recipient') IS NOT NULL), " +
	"('direct messages recipient index', " +
	"to_regclass('direct_messages_by_recipient_and_sender') IS NOT NULL), " +
	"('users primary key', EXISTS (SELECT 1 FROM pg_constraint " +
	"WHERE conrelid = to_regclass('users') AND contype = 'p')), " +
	"('server roles primary key', EXISTS (SELECT 1 FROM pg_constraint " +
	"WHERE conrelid = to_regclass('server_roles') AND contype = 'p')), " +
	"('user server roles primary key', EXISTS (SELECT 1 FROM pg_constraint " +
	"WHERE conrelid = to_regclass('user_server_roles') AND contype = 'p')), " +
	"('rooms primary key', EXISTS (SELECT 1 FROM pg_constraint " +
	"WHERE conrelid = to_regclass('rooms') AND contype = 'p')), " +
	"('room members primary key', EXISTS (SELECT 1 FROM pg_constraint " +
	"WHERE conrelid = to_regclass('room_members') AND contype = 'p')), " +
	"('chat messages primary key', EXISTS (SELECT 1 FROM pg_constraint " +
	"WHERE conrelid = to_regclass('chat_messages') AND contype = 'p')), " +
	"('direct messages primary key', EXISTS (SELECT 1 FROM pg_constraint " +
	"WHERE conrelid = to_regclass('direct_messages') AND contype = 'p'))"

DATABASE_SCHEMA_MIGRATIONS_CHECKS ::
	"('schema_migrations table', to_regclass('schema_migrations') IS NOT NULL), " +
	"('schema_migrations columns', (SELECT count(*) = 3 FROM information_schema.columns " +
	"WHERE table_schema = current_schema() AND table_name = 'schema_migrations' " +
	"AND column_name IN ('version', 'name', 'applied_at'))), " +
	"('schema_migrations primary key', EXISTS (SELECT 1 FROM pg_constraint " +
	"WHERE conrelid = to_regclass('schema_migrations') AND contype = 'p'))"

// Adoption: an unversioned database must match the version 1 schema once migration 1 ran.
DATABASE_BASELINE_VALIDATION_SQL ::
	DATABASE_SCHEMA_VALIDATION_PREFIX +
	DATABASE_BASELINE_SCHEMA_CHECKS +
	DATABASE_SCHEMA_VALIDATION_SUFFIX

// The safety net after migrating: the newest schema plus the runner's bookkeeping. A
// migration that adds objects appends its checks here and sets the same constant as its
// `checks`; one that changes a baseline object replaces DATABASE_BASELINE_SCHEMA_CHECKS here
// with an edited copy (the frozen constant stays, for adoption).
// testDatabaseSchemaValidationMatchesTheMigrationList pins this to
// databaseSchemaValidationQuery(DATABASE_MIGRATIONS[:]), which is what the runner executes.
DATABASE_SCHEMA_VALIDATION_SQL ::
	DATABASE_SCHEMA_VALIDATION_PREFIX +
	DATABASE_BASELINE_SCHEMA_CHECKS +
	", " +
	DATABASE_SCHEMA_MIGRATIONS_CHECKS +
	", " +
	DATABASE_READ_MARKERS_CHECKS +
	", " +
	DATABASE_ADMIN_CHECKS +
	", " +
	DATABASE_ROOM_ACCESS_CHECKS +
	", " +
	DATABASE_USER_ENCRYPTION_KEYS_CHECKS +
	", " +
	DATABASE_ENCRYPTED_DIRECT_MESSAGES_CHECKS +
	", " +
	DATABASE_ENCRYPTED_ROOM_LOG_CHECKS +
	", " +
	DATABASE_ROOM_SENDER_CHAINS_CHECKS +
	", " +
	DATABASE_ROOM_KEY_FORWARDS_CHECKS +
	", " +
	DATABASE_SIGNED_MESSAGES_CHECKS +
	", " +
	DATABASE_ROLES_CHECKS +
	DATABASE_SCHEMA_VALIDATION_SUFFIX

// The validation query for the schema migrations builds: the baseline, the runner's
// bookkeeping, and each later migration's checks. Allocated with allocator.
databaseSchemaValidationQuery :: proc(
	migrations: []DatabaseMigration,
	allocator := context.allocator,
) -> string {
	builder := strings.builder_make(allocator)
	strings.write_string(&builder, DATABASE_SCHEMA_VALIDATION_PREFIX)
	strings.write_string(&builder, DATABASE_BASELINE_SCHEMA_CHECKS)
	strings.write_string(&builder, ", ")
	strings.write_string(&builder, DATABASE_SCHEMA_MIGRATIONS_CHECKS)
	for migration in migrations {
		if len(migration.checks) > 0 {
			strings.write_string(&builder, ", ")
			strings.write_string(&builder, migration.checks)
		}
	}
	strings.write_string(&builder, DATABASE_SCHEMA_VALIDATION_SUFFIX)
	return strings.to_string(builder)
}

// Returns an empty string when the list is usable: versions 1, 2, 3, ... in order, with unique
// non-empty names and non-empty SQL. The caller frees a non-empty error.
databaseMigrationListError :: proc(migrations: []DatabaseMigration) -> string {
	if len(migrations) == 0 {
		return strings.clone("the database migration list is empty")
	}
	for migration, index in migrations {
		if migration.version != index + 1 {
			return fmt.aprintf(
				"database migration %d has version %d; versions start at 1 and increase by one",
				index + 1,
				migration.version,
			)
		}
		if len(migration.name) == 0 {
			return fmt.aprintf("database migration %d has no name", migration.version)
		}
		if len(strings.trim_space(migration.sql)) == 0 {
			return fmt.aprintf(
				"database migration %d (%s) has no SQL",
				migration.version,
				migration.name,
			)
		}
		for earlier in migrations[:index] {
			if earlier.name == migration.name {
				return fmt.aprintf(
					"database migrations %d and %d share the name %q",
					earlier.version,
					migration.version,
					migration.name,
				)
			}
		}
	}
	return ""
}

// Runs query, which returns one row with one text column naming the failed checks. Returns an
// empty string when every check passed. The caller frees a non-empty error.
databaseSchemaValidationError :: proc(conn: pg.Conn, query: string) -> string {
	queryCString, queryCStringErr := strings.clone_to_cstring(query)
	if queryCStringErr != nil {
		return strings.clone("could not allocate database schema validation query")
	}
	defer delete(queryCString)

	result := pg.exec(conn, queryCString)
	if result == nil {
		return databaseMigrationDetail("database schema validation failed", pg.error_message(conn))
	}
	defer pg.clear(result)
	if pg.result_status(result) != .Tuples_OK || pg.n_tuples(result) != 1 {
		return databaseMigrationDetail(
			"database schema validation failed",
			pg.result_error_message(result),
		)
	}

	failed := databaseGetText(result, 0, 0)
	if len(failed) == 0 {
		return ""
	}
	defer delete(failed)
	return fmt.aprintf("these checks failed: %s", failed)
}

// Formats "operation: detail" from a PostgreSQL error message, which ends in a newline.
databaseMigrationDetail :: proc(operation: string, detail: cstring) -> string {
	text := strings.trim_space(string(detail))
	if len(text) == 0 {
		return strings.clone(operation)
	}
	return fmt.aprintf("%s: %s", operation, text)
}

// Takes ownership of detail and returns the full refusal: what failed, then the recovery hint.
databaseMigrationRefusal :: proc(detail: string) -> string {
	defer delete(detail)
	return fmt.aprintf("%s. %s", detail, DATABASE_MIGRATION_RECOVERY_HINT)
}

// Runs one statement string that returns no rows of interest. The caller frees a non-empty
// error, which is "operation: PostgreSQL error".
databaseMigrationExec :: proc(conn: pg.Conn, operation: string, query: string) -> string {
	queryCString, queryCStringErr := strings.clone_to_cstring(query)
	if queryCStringErr != nil {
		return fmt.aprintf("%s: could not allocate the query", operation)
	}
	defer delete(queryCString)

	result := pg.exec(conn, queryCString)
	if result == nil {
		return databaseMigrationDetail(operation, pg.error_message(conn))
	}
	defer pg.clear(result)
	status := pg.result_status(result)
	if status == .Fatal_Error || status == .Bad_Response {
		return databaseMigrationDetail(operation, pg.result_error_message(result))
	}
	return ""
}

databaseMigrationLock :: proc(conn: pg.Conn) -> string {
	key := fmt.caprintf("%d", DATABASE_MIGRATION_LOCK_KEY)
	defer delete(key)
	params := [1][^]byte{transmute([^]byte)key}
	result := databaseExecParams(conn, DATABASE_MIGRATION_LOCK_SQL, params[:])
	if result == nil {
		return databaseMigrationDetail(
			"could not lock the database schema",
			pg.error_message(conn),
		)
	}
	defer pg.clear(result)
	if pg.result_status(result) != .Tuples_OK {
		return databaseMigrationDetail(
			"could not lock the database schema",
			pg.result_error_message(result),
		)
	}
	return ""
}

databaseMigrationRecord :: proc(conn: pg.Conn, migration: DatabaseMigration) -> string {
	version := databaseIntParam(migration.version)
	defer delete(version)
	name, nameErr := strings.clone_to_cstring(migration.name)
	if nameErr != nil {
		return strings.clone("could not allocate a database migration name")
	}
	defer delete(name)
	params := [2][^]byte{transmute([^]byte)version, transmute([^]byte)name}
	result := databaseExecParams(conn, DATABASE_MIGRATION_RECORD_SQL, params[:])
	operation := fmt.tprintf(
		"could not record database migration %d (%s)",
		migration.version,
		migration.name,
	)
	if result == nil {
		return databaseMigrationDetail(operation, pg.error_message(conn))
	}
	defer pg.clear(result)
	if pg.result_status(result) != .Command_OK {
		return databaseMigrationDetail(operation, pg.result_error_message(result))
	}
	return ""
}

// The recorded schema version and whether the current schema holds baseline tables.
DatabaseMigrationState :: struct {
	recordedVersion: int,
	recordedCount:   int,
	lowestVersion:   int,
	baselineTables:  int,
}

databaseMigrationReadState :: proc(conn: pg.Conn) -> (DatabaseMigrationState, string) {
	result := pg.exec(conn, DATABASE_MIGRATION_STATE_SQL)
	if result == nil {
		return {}, databaseMigrationDetail(
			"could not read the database schema version",
			pg.error_message(conn),
		)
	}
	defer pg.clear(result)
	if pg.result_status(result) != .Tuples_OK || pg.n_tuples(result) != 1 {
		return {}, databaseMigrationDetail(
			"could not read the database schema version",
			pg.result_error_message(result),
		)
	}
	state: DatabaseMigrationState
	versionOK, countOK, lowestOK, tablesOK: bool
	state.recordedVersion, versionOK = databaseGetInt(result, 0, 0)
	state.recordedCount, countOK = databaseGetInt(result, 0, 1)
	state.lowestVersion, lowestOK = databaseGetInt(result, 0, 2)
	state.baselineTables, tablesOK = databaseGetInt(result, 0, 3)
	if !versionOK || !countOK || !lowestOK || !tablesOK {
		return {}, strings.clone("could not read the database schema version: invalid row")
	}
	return state, ""
}

// Brings the schema to the newest migration in migrations, inside the caller's transaction.
// The caller rolls back on an error, which describes what failed and how to recover, and which
// the caller frees. Production passes DATABASE_MIGRATIONS[:]; tests pass lists of their own.
databaseApplyMigrations :: proc(
	conn: pg.Conn,
	migrations: []DatabaseMigration,
) -> (
	DatabaseMigrationOutcome,
	string,
) {
	if listErr := databaseMigrationListError(migrations); len(listErr) > 0 {
		return {}, listErr
	}
	newest := len(migrations)

	// CREATE ... IF NOT EXISTS reports every existing object as a NOTICE, which libpq prints to
	// stderr; a start that changes nothing should log nothing. LOCAL ends with the transaction.
	if quietErr := databaseMigrationExec(
		conn,
		"could not lower client_min_messages",
		"SET LOCAL client_min_messages TO warning",
	); len(quietErr) > 0 {
		return {}, databaseMigrationRefusal(quietErr)
	}
	if lockErr := databaseMigrationLock(conn); len(lockErr) > 0 {
		return {}, databaseMigrationRefusal(lockErr)
	}
	if createErr := databaseMigrationExec(
		conn,
		"could not create schema_migrations",
		DATABASE_SCHEMA_MIGRATIONS_CREATE_SQL,
	); len(createErr) > 0 {
		return {}, databaseMigrationRefusal(createErr)
	}
	state, stateErr := databaseMigrationReadState(conn)
	if len(stateErr) > 0 {
		return {}, databaseMigrationRefusal(stateErr)
	}

	if state.recordedVersion > newest {
		return {}, fmt.aprintf(
			"database schema version %d is newer than this server supports (%d); run a newer " +
			"server or restore the backup taken before the upgrade",
			state.recordedVersion,
			newest,
		)
	}
	// Versions are recorded one by one from 1, so anything but 1..max means someone edited
	// schema_migrations by hand and the runner cannot know which migrations really ran.
	if state.recordedCount != state.recordedVersion || state.lowestVersion != 1 {
		return {}, databaseMigrationRefusal(
			fmt.aprintf(
				"schema_migrations is inconsistent: it records %d versions up to %d, " +
				"expected exactly 1 to %d",
				state.recordedCount,
				state.recordedVersion,
				state.recordedVersion,
			),
		)
	}

	outcome := DatabaseMigrationOutcome {
		previousVersion = state.recordedVersion,
		version         = newest,
	}
	version := state.recordedVersion

	// HayChat tables without a recorded version: a database from before migrations. Migration
	// 1 is idempotent, so running it adds what an older schema lacks without touching rows; the
	// result must then be exactly the version 1 schema before the runner vouches for it.
	if version == 0 && state.baselineTables > 0 {
		baseline := migrations[0]
		if execErr := databaseMigrationExec(
			conn,
			fmt.tprintf(
				"the existing HayChat tables have no schema version, and migration 1 (%s) " +
				"could not adopt them",
				baseline.name,
			),
			baseline.sql,
		); len(execErr) > 0 {
			return {}, databaseMigrationRefusal(execErr)
		}
		if validationErr := databaseSchemaValidationError(
			conn,
			DATABASE_BASELINE_VALIDATION_SQL,
		); len(validationErr) > 0 {
			defer delete(validationErr)
			return {}, databaseMigrationRefusal(
				fmt.aprintf(
					"the existing HayChat tables have no schema version and do not match " +
					"schema version 1, so the server cannot adopt them (%s)",
					validationErr,
				),
			)
		}
		if recordErr := databaseMigrationRecord(conn, baseline); len(recordErr) > 0 {
			return {}, databaseMigrationRefusal(recordErr)
		}
		outcome.adopted = true
		version = 1
	}

	for migration in migrations[version:] {
		if execErr := databaseMigrationExec(
			conn,
			fmt.tprintf("database migration %d (%s) failed", migration.version, migration.name),
			migration.sql,
		); len(execErr) > 0 {
			return {}, databaseMigrationRefusal(execErr)
		}
		if recordErr := databaseMigrationRecord(conn, migration); len(recordErr) > 0 {
			return {}, databaseMigrationRefusal(recordErr)
		}
	}

	validationQuery := databaseSchemaValidationQuery(migrations)
	defer delete(validationQuery)
	if validationErr := databaseSchemaValidationError(
		conn,
		validationQuery,
	); len(validationErr) > 0 {
		defer delete(validationErr)
		return {}, databaseMigrationRefusal(
			fmt.aprintf(
				"the database schema at version %d is incompatible with this server (%s)",
				newest,
				validationErr,
			),
		)
	}
	return outcome, ""
}

// Startup: runs databaseApplyMigrations in a transaction of its own and commits only when the
// whole schema is ready, so a refused or failed start leaves the database as it found it.
// The caller frees a non-empty error.
databaseMigrateSchema :: proc(
	conn: pg.Conn,
	migrations: []DatabaseMigration,
) -> (
	DatabaseMigrationOutcome,
	string,
) {
	if beginErr := databaseMigrationExec(
		conn,
		"could not begin the database migration transaction",
		"BEGIN",
	); len(beginErr) > 0 {
		return {}, beginErr
	}
	outcome, err := databaseApplyMigrations(conn, migrations)
	if len(err) > 0 {
		rollbackErr := databaseMigrationExec(conn, "rollback", "ROLLBACK")
		delete(rollbackErr)
		return {}, err
	}
	if commitErr := databaseMigrationExec(
		conn,
		"could not commit the database migrations",
		"COMMIT",
	); len(commitErr) > 0 {
		return {}, databaseMigrationRefusal(commitErr)
	}
	return outcome, ""
}

// Logs what a committed databaseMigrateSchema changed: one line for an adoption and one per
// applied migration. A start that changed nothing logs nothing.
databaseLogMigrationOutcome :: proc(
	outcome: DatabaseMigrationOutcome,
	migrations: []DatabaseMigration,
) {
	first := outcome.previousVersion
	if outcome.adopted {
		fmt.printfln(
			"[Database] Adopted the existing database schema as migration 1 (%s)",
			migrations[0].name,
		)
		first = 1
	}
	if first >= outcome.version || outcome.version > len(migrations) {
		return
	}
	for migration in migrations[first:outcome.version] {
		fmt.printfln(
			"[Database] Applied database migration %d (%s)",
			migration.version,
			migration.name,
		)
	}
}
