package server

import "core:fmt"
import "core:os"
import "core:testing"
import "core:time"
import "shared:pg"

// Runs the default room statement against a real PostgreSQL when HAYCHAT_DATABASE_SQL_TEST=1
// (dev/live-proof.sh --all and --sql). Everything happens inside one transaction in a schema of
// its own that is rolled back, so the rooms table starts empty with a fresh identity sequence
// and the running server's rooms in public are never touched.

databaseDefaultRoomTestExec :: proc(conn: pg.Conn, operation: string, query: string) {
	err := databaseMigrationExec(conn, operation, query)
	assert(len(err) == 0, err)
}

// Returns column 0 of the single row query returns. The caller frees it.
databaseDefaultRoomTestValue :: proc(conn: pg.Conn, query: cstring) -> string {
	result := pg.exec(conn, query)
	assert(result != nil, "expected the check query to reach PostgreSQL")
	defer pg.clear(result)
	assert(
		pg.result_status(result) == .Tuples_OK && pg.n_tuples(result) == 1,
		fmt.tprintf(
			"expected one row from %q: %s",
			query,
			string(pg.result_error_message(result)),
		),
	)
	return databaseGetText(result, 0, 0)
}

@(test)
testDefaultRoomStatementAgainstPostgreSQL :: proc(t: ^testing.T) {
	_ = t
	if os.get_env(DATABASE_SQL_TEST_ENV, context.temp_allocator) != "1" {
		return
	}

	conn, openErr := databaseOpenRuntimeConnection(databaseSQLTestConfig())
	assert(len(openErr) == 0, openErr)
	defer pg.finish(conn)

	schema := fmt.tprintf("haychat_default_room_test_%d", time.time_to_unix_nano(time.now()))
	databaseDefaultRoomTestExec(conn, "begin default room test", "BEGIN")
	defer databaseDefaultRoomTestExec(conn, "roll back default room test", "ROLLBACK")
	databaseDefaultRoomTestExec(
		conn,
		"isolate default room test",
		fmt.tprintf("CREATE SCHEMA %s; SET LOCAL search_path TO %s", schema, schema),
	)

	// Start from a protocol 7 rooms table, whose creator column is NOT NULL, to prove the
	// migrations adopt and upgrade it in place rather than needing a rebuild.
	databaseDefaultRoomTestExec(
		conn,
		"create protocol 7 tables",
		"CREATE TABLE users (" +
		"id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " +
		"nickname VARCHAR(32) NOT NULL UNIQUE); " +
		"CREATE TABLE rooms (" +
		"id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " +
		"name VARCHAR(64) NOT NULL UNIQUE, " +
		"description VARCHAR(256) NOT NULL DEFAULT '', " +
		"created_by_user_id BIGINT NOT NULL REFERENCES users(id), " +
		"created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP); " +
		"INSERT INTO users (nickname) VALUES ('room-alice'), ('room-bob')",
	)
	{
		outcome, migrateErr := databaseApplyMigrations(conn, DATABASE_MIGRATIONS[:])
		assert(len(migrateErr) == 0, migrateErr)
		assert(outcome.adopted, "expected the protocol 7 tables to be adopted as version 1")
	}
	{
		nullable := databaseDefaultRoomTestValue(
			conn,
			"SELECT is_nullable FROM information_schema.columns " +
			"WHERE table_schema = current_schema() AND table_name = 'rooms' " +
			"AND column_name = 'created_by_user_id'",
		)
		defer delete(nullable)
		assert(nullable == "YES", fmt.tprintf("expected a nullable creator, got %q", nullable))
	}

	firstRoomID, firstErr := databaseEnsureDefaultRoom(conn)
	assert(len(firstErr) == 0, firstErr)
	assert(firstRoomID == 1, fmt.tprintf("expected #general to get ID 1, got %d", firstRoomID))
	secondRoomID, secondErr := databaseEnsureDefaultRoom(conn)
	assert(len(secondErr) == 0, secondErr)
	assert(
		secondRoomID == 0,
		fmt.tprintf("expected the second run to create nothing, got room %d", secondRoomID),
	)

	{
		rooms := databaseDefaultRoomTestValue(
			conn,
			"SELECT string_agg(id || ':' || name || ':' || description || ':' || " +
			"COALESCE(created_by_user_id::text, 'none'), ',') FROM rooms",
		)
		defer delete(rooms)
		assert(
			rooms == "1:general:General discussion:none",
			fmt.tprintf("expected exactly #general with no creator, got %q", rooms),
		)
	}
	{
		// Every account is a member, and only accounts are members.
		missing := databaseDefaultRoomTestValue(
			conn,
			"SELECT count(*)::text || '/' || (SELECT count(*) FROM room_members)::text " +
			"FROM users u WHERE NOT EXISTS (SELECT 1 FROM room_members rm " +
			"WHERE rm.room_id = 1 AND rm.user_id = u.id)",
		)
		defer delete(missing)
		assert(
			missing == "0/2",
			fmt.tprintf("expected both accounts in #general and nothing else, got %q", missing),
		)
	}

	// An account created after startup joins #general through the identity statement.
	newUserID := databaseSQLTestCreateUser(conn, "room-carol")
	{
		joined := databaseDefaultRoomTestValue(
			conn,
			fmt.ctprintf(
				"SELECT count(*)::text FROM room_members WHERE room_id = 1 AND user_id = %d",
				newUserID,
			),
		)
		defer delete(joined)
		assert(joined == "1", "expected a new account to join #general")
	}
}
