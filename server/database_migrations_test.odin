package server

import "core:fmt"
import "core:os"
import "core:strings"
import "core:testing"
import "core:time"
import "shared:pg"

// Tests for the schema migration runner. The pure tests always run. The SQL tests run against
// a real PostgreSQL only when HAYCHAT_DATABASE_SQL_TEST=1 (dev/live-proof.sh --all and --sql).
// Each creates a schema of its own, points search_path at it, lets the runner commit, and drops
// the schema at the end, so it must point only at a throwaway database; the running server's
// tables in public are never read or written.

// The schema v0.1.0-rc1 created, copied from that tag's server/database.odin. Frozen: it is
// what testers' databases hold, so it must not follow later edits to the live migration list.
DATABASE_MIGRATION_TEST_RC1_CREATE_SQL ::
	"CREATE TABLE IF NOT EXISTS users (" +
	"id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " +
	"nickname VARCHAR(32) NOT NULL UNIQUE, " +
	"public_key BYTEA, " +
	"CHECK (char_length(nickname) BETWEEN 3 AND 32)); " +
	"ALTER TABLE users ADD COLUMN IF NOT EXISTS public_key BYTEA; " +
	"CREATE UNIQUE INDEX IF NOT EXISTS users_public_key_unique ON users (public_key); " +
	"CREATE TABLE IF NOT EXISTS server_roles (" +
	"id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " +
	"name VARCHAR(32) NOT NULL UNIQUE, " +
	"CHECK (char_length(name) BETWEEN 3 AND 32)); " +
	"CREATE TABLE IF NOT EXISTS user_server_roles (" +
	"user_id BIGINT NOT NULL REFERENCES users(id) ON DELETE CASCADE, " +
	"role_id BIGINT NOT NULL REFERENCES server_roles(id) ON DELETE CASCADE, " +
	"PRIMARY KEY (user_id, role_id)); " +
	"CREATE TABLE IF NOT EXISTS rooms (" +
	"id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " +
	"name VARCHAR(64) NOT NULL UNIQUE, " +
	"description VARCHAR(256) NOT NULL DEFAULT '', " +
	"created_by_user_id BIGINT REFERENCES users(id), " +
	"created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP, " +
	"CHECK (char_length(name) BETWEEN 1 AND 64)); " +
	// The server creates the default room itself, before any account exists, so a room may
	// have no creator. Protocol 7 databases have the NOT NULL; this upgrades them in place.
	"ALTER TABLE rooms ALTER COLUMN created_by_user_id DROP NOT NULL; " +
	"CREATE TABLE IF NOT EXISTS room_members (" +
	"room_id BIGINT NOT NULL REFERENCES rooms(id) ON DELETE CASCADE, " +
	"user_id BIGINT NOT NULL REFERENCES users(id) ON DELETE CASCADE, " +
	"joined_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP, " +
	"PRIMARY KEY (room_id, user_id)); " +
	"CREATE TABLE IF NOT EXISTS chat_messages (" +
	"id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " +
	"room_id BIGINT NOT NULL REFERENCES rooms(id) ON DELETE CASCADE, " +
	"sender_user_id BIGINT NOT NULL REFERENCES users(id), " +
	"content TEXT NOT NULL, " +
	"created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP, " +
	"CHECK (char_length(content) BETWEEN 1 AND 4000)); " +
	"CREATE TABLE IF NOT EXISTS direct_messages (" +
	"id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, " +
	"sender_user_id BIGINT NOT NULL REFERENCES users(id) ON DELETE CASCADE, " +
	"recipient_user_id BIGINT NOT NULL REFERENCES users(id) ON DELETE CASCADE, " +
	"content TEXT NOT NULL, " +
	"created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP, " +
	"CHECK (char_length(content) BETWEEN 1 AND 4000), " +
	"CHECK (sender_user_id <> recipient_user_id)); " +
	"CREATE INDEX IF NOT EXISTS room_members_by_user_id ON room_members (user_id, room_id); " +
	"CREATE INDEX IF NOT EXISTS chat_messages_by_room_id_and_id " +
	"ON chat_messages (room_id, id DESC); " +
	// One index per direction: a conversation page reads both, and the conversation list
	// scans each user's sent and received messages.
	"CREATE INDEX IF NOT EXISTS direct_messages_by_sender_and_recipient " +
	"ON direct_messages (sender_user_id, recipient_user_id, id); " +
	"CREATE INDEX IF NOT EXISTS direct_messages_by_recipient_and_sender " +
	"ON direct_messages (recipient_user_id, sender_user_id, id);"

@(test)
testDatabaseMigrationListIsOrderedAndGapless :: proc(t: ^testing.T) {
	_ = t
	listErr := databaseMigrationListError(DATABASE_MIGRATIONS[:])
	defer delete(listErr)
	assert(len(listErr) == 0, fmt.tprintf("expected a usable migration list, got %q", listErr))
	assert(DATABASE_MIGRATIONS[0].version == 1, "expected the migration list to start at 1")
	for migration, index in DATABASE_MIGRATIONS {
		assert(
			migration.version == index + 1,
			fmt.tprintf("expected migration %d to have version %d", migration.version, index + 1),
		)
		assert(len(migration.name) > 0, fmt.tprintf("expected migration %d to have a name", index))
		for earlier in DATABASE_MIGRATIONS[:index] {
			assert(
				earlier.name != migration.name,
				fmt.tprintf("expected unique names, %q appears twice", migration.name),
			)
		}
	}
}

@(test)
testDatabaseBaselineMigrationIsTheRC1Schema :: proc(t: ^testing.T) {
	_ = t
	assert(
		DATABASE_MIGRATIONS[0].name == "baseline",
		fmt.tprintf("expected migration 1 to be the baseline, got %q", DATABASE_MIGRATIONS[0].name),
	)
	// Merged migrations are never edited: the baseline is what v0.1.0-rc1 created.
	assert(
		DATABASE_MIGRATIONS[0].sql == DATABASE_MIGRATION_TEST_RC1_CREATE_SQL,
		"expected migration 1 to be exactly the v0.1.0-rc1 schema; append a migration instead",
	)
	assert(
		strings.contains(
			DATABASE_MIGRATIONS[0].sql,
			"ALTER TABLE rooms ALTER COLUMN created_by_user_id DROP NOT NULL",
		),
		"expected the baseline to keep the protocol 7 rooms upgrade",
	)
}

@(test)
testDatabaseMigrationLockKeyIsPinned :: proc(t: ^testing.T) {
	_ = t
	// An old and a new server must take the same lock, so the key never changes.
	assert(
		DATABASE_MIGRATION_LOCK_KEY == 0x4861_7943_6861_7401,
		fmt.tprintf("expected the pinned migration lock key, got %x", DATABASE_MIGRATION_LOCK_KEY),
	)
	assert(
		strings.contains(DATABASE_MIGRATION_LOCK_SQL, "pg_advisory_xact_lock"),
		"expected a transaction-scoped advisory lock, released by COMMIT or ROLLBACK",
	)
}

@(test)
testDatabaseMigrationListErrorRejectsBadLists :: proc(t: ^testing.T) {
	_ = t
	Case :: struct {
		label:      string,
		migrations: []DatabaseMigration,
		expected:   string,
	}
	cases := [?]Case {
		{"empty", {}, "empty"},
		{"starts at 2", {{2, "two", "SELECT 1"}}, "has version 2"},
		{"gap", {{1, "one", "SELECT 1"}, {3, "three", "SELECT 1"}}, "has version 3"},
		{"duplicate version", {{1, "one", "SELECT 1"}, {1, "again", "SELECT 1"}}, "version 1"},
		{"empty name", {{1, "", "SELECT 1"}}, "no name"},
		{"duplicate name", {{1, "same", "SELECT 1"}, {2, "same", "SELECT 1"}}, "share the name"},
		{"empty SQL", {{1, "one", "  "}}, "no SQL"},
	}
	for testCase in cases {
		listErr := databaseMigrationListError(testCase.migrations)
		defer delete(listErr)
		assert(
			strings.contains(listErr, testCase.expected),
			fmt.tprintf(
				"expected the %s list to fail with %q, got %q",
				testCase.label,
				testCase.expected,
				listErr,
			),
		)
	}
	okErr := databaseMigrationListError(
		[]DatabaseMigration{{1, "one", "SELECT 1"}, {2, "two", "SELECT 2"}},
	)
	assert(len(okErr) == 0, fmt.tprintf("expected a gapless list to pass, got %q", okErr))
}

// Opens a connection whose search_path is a new, empty schema. The caller defers
// databaseMigrationTestClose, which drops the schema again.
databaseMigrationTestOpen :: proc(label: string) -> (pg.Conn, string) {
	conn, openErr := databaseOpenRuntimeConnection(databaseSQLTestConfig())
	assert(len(openErr) == 0, openErr)
	schema := fmt.tprintf("haychat_migration_%s_%d", label, time.time_to_unix_nano(time.now()))
	databaseDefaultRoomTestExec(
		conn,
		"isolate migration test",
		fmt.tprintf(
			"SET client_min_messages TO warning; CREATE SCHEMA %s; SET search_path TO %s",
			schema,
			schema,
		),
	)
	return conn, schema
}

databaseMigrationTestClose :: proc(conn: pg.Conn, schema: string) {
	databaseDefaultRoomTestExec(
		conn,
		"drop migration test schema",
		fmt.tprintf("DROP SCHEMA %s CASCADE", schema),
	)
	pg.finish(conn)
}

// Runs databaseMigrateSchema and requires it to succeed.
databaseMigrationTestMigrate :: proc(
	conn: pg.Conn,
	migrations: []DatabaseMigration,
) -> DatabaseMigrationOutcome {
	outcome, err := databaseMigrateSchema(conn, migrations)
	assert(len(err) == 0, fmt.tprintf("expected the migrations to run, got %q", err))
	return outcome
}

// Runs databaseMigrateSchema, requires it to refuse with an error containing expected, and
// requires that the error names the recovery path.
databaseMigrationTestRefuse :: proc(
	conn: pg.Conn,
	migrations: []DatabaseMigration,
	expected: string,
) {
	_, err := databaseMigrateSchema(conn, migrations)
	defer delete(err)
	assert(
		strings.contains(err, expected),
		fmt.tprintf("expected the migrations to refuse with %q, got %q", expected, err),
	)
	assert(
		strings.contains(err, "backup"),
		fmt.tprintf("expected the refusal to say how to restore a backup, got %q", err),
	)
}

// Column 0 of the single row query returns, in the temp allocator.
databaseMigrationTestValue :: proc(conn: pg.Conn, query: string) -> string {
	value := databaseDefaultRoomTestValue(conn, fmt.ctprintf("%s", query))
	defer delete(value)
	return strings.clone(value, context.temp_allocator)
}

databaseMigrationTestRecorded :: proc(conn: pg.Conn) -> string {
	return databaseMigrationTestValue(
		conn,
		"SELECT COALESCE(string_agg(version || ':' || name, ',' ORDER BY version), '') " +
		"FROM schema_migrations",
	)
}

// The recorded versions of the whole production list, as databaseMigrationTestRecorded shows them.
databaseMigrationTestExpectedRecorded :: proc() -> string {
	builder := strings.builder_make(context.temp_allocator)
	for migration, index in DATABASE_MIGRATIONS {
		if index > 0 {
			strings.write_byte(&builder, ',')
		}
		fmt.sbprintf(&builder, "%d:%s", migration.version, migration.name)
	}
	return strings.to_string(builder)
}

databaseMigrationTestValidationPasses :: proc(conn: pg.Conn) {
	validationErr := databaseSchemaValidationError(conn, DATABASE_SCHEMA_VALIDATION_SQL)
	defer delete(validationErr)
	assert(
		len(validationErr) == 0,
		fmt.tprintf("expected the newest schema to validate, got %q", validationErr),
	)
}

// Every row of every baseline table, with every column, so any lost or changed row shows.
DATABASE_MIGRATION_TEST_FINGERPRINT_SQL ::
	"SELECT concat_ws(' | ', " +
	"(SELECT string_agg(id || ':' || nickname || ':' || " +
	"COALESCE(encode(public_key, 'hex'), '-'), ',' ORDER BY id) FROM users), " +
	"(SELECT string_agg(id || ':' || name, ',' ORDER BY id) FROM server_roles), " +
	"(SELECT string_agg(user_id || ':' || role_id, ',' ORDER BY user_id, role_id) " +
	"FROM user_server_roles), " +
	"(SELECT string_agg(id || ':' || name || ':' || description || ':' || " +
	"COALESCE(created_by_user_id::text, '-') || ':' || created_at, ',' ORDER BY id) FROM rooms), " +
	"(SELECT string_agg(room_id || ':' || user_id || ':' || joined_at, ',' " +
	"ORDER BY room_id, user_id) FROM room_members), " +
	"(SELECT string_agg(id || ':' || room_id || ':' || sender_user_id || ':' || content || " +
	"':' || created_at, ',' ORDER BY id) FROM chat_messages), " +
	"(SELECT string_agg(id || ':' || sender_user_id || ':' || recipient_user_id || ':' || " +
	"content || ':' || created_at, ',' ORDER BY id) FROM direct_messages))"

DATABASE_MIGRATION_TEST_COUNTS_SQL ::
	"SELECT concat_ws('/', (SELECT count(*) FROM users), (SELECT count(*) FROM server_roles), " +
	"(SELECT count(*) FROM user_server_roles), (SELECT count(*) FROM rooms), " +
	"(SELECT count(*) FROM room_members), (SELECT count(*) FROM chat_messages), " +
	"(SELECT count(*) FROM direct_messages))"

// Rows like an rc1 server holds after use: three accounts (one keyless), an admin role, the
// default room with no creator and a room an admin made, members, room history, and DMs.
DATABASE_MIGRATION_TEST_RC1_ROWS_SQL ::
	"INSERT INTO users (nickname, public_key) VALUES ('mig-alice', '\\x01'), " +
	"('mig-bob', '\\x02'), ('mig-carol', NULL); " +
	"INSERT INTO server_roles (name) VALUES ('admin'); " +
	"INSERT INTO user_server_roles (user_id, role_id) VALUES (1, 1); " +
	"INSERT INTO rooms (name, description) VALUES ('general', 'General discussion'); " +
	"INSERT INTO rooms (name, description, created_by_user_id) VALUES ('lounge', 'Chat', 1); " +
	"INSERT INTO room_members (room_id, user_id) VALUES (1, 1), (1, 2), (1, 3), (2, 1), (2, 2); " +
	"INSERT INTO chat_messages (room_id, sender_user_id, content) VALUES " +
	"(1, 1, 'hello general'), (2, 2, 'hello lounge'); " +
	"INSERT INTO direct_messages (sender_user_id, recipient_user_id, content) VALUES " +
	"(1, 2, 'hi bob'), (2, 1, 'hi alice')"

@(test)
testMigrationsCreateFreshSchemaAgainstPostgreSQL :: proc(t: ^testing.T) {
	_ = t
	if os.get_env(DATABASE_SQL_TEST_ENV, context.temp_allocator) != "1" {
		return
	}
	conn, schema := databaseMigrationTestOpen("fresh")
	defer databaseMigrationTestClose(conn, schema)

	newest := len(DATABASE_MIGRATIONS)
	outcome := databaseMigrationTestMigrate(conn, DATABASE_MIGRATIONS[:])
	assert(
		outcome == DatabaseMigrationOutcome{previousVersion = 0, version = newest},
		fmt.tprintf("expected an empty schema to get every migration, got %v", outcome),
	)
	databaseMigrationTestValidationPasses(conn)
	recorded := databaseMigrationTestRecorded(conn)
	expected := databaseMigrationTestExpectedRecorded()
	assert(
		recorded == expected,
		fmt.tprintf("expected schema_migrations to hold %q, got %q", expected, recorded),
	)

	// A second start changes nothing.
	again := databaseMigrationTestMigrate(conn, DATABASE_MIGRATIONS[:])
	assert(
		again == DatabaseMigrationOutcome{previousVersion = newest, version = newest},
		fmt.tprintf("expected the second run to be a no-op, got %v", again),
	)
	recordedAgain := databaseMigrationTestRecorded(conn)
	assert(
		recordedAgain == expected,
		fmt.tprintf("expected the second run to record nothing, got %q", recordedAgain),
	)
}

@(test)
testMigrationsAdoptRC1SchemaAgainstPostgreSQL :: proc(t: ^testing.T) {
	_ = t
	if os.get_env(DATABASE_SQL_TEST_ENV, context.temp_allocator) != "1" {
		return
	}
	conn, schema := databaseMigrationTestOpen("rc1")
	defer databaseMigrationTestClose(conn, schema)

	databaseDefaultRoomTestExec(conn, "create rc1 schema", DATABASE_MIGRATION_TEST_RC1_CREATE_SQL)
	databaseDefaultRoomTestExec(conn, "fill rc1 schema", DATABASE_MIGRATION_TEST_RC1_ROWS_SQL)
	counts := databaseMigrationTestValue(conn, DATABASE_MIGRATION_TEST_COUNTS_SQL)
	assert(counts == "3/1/1/2/5/2/2", fmt.tprintf("expected the rc1 rows, got %q", counts))
	before := databaseMigrationTestValue(conn, DATABASE_MIGRATION_TEST_FINGERPRINT_SQL)

	newest := len(DATABASE_MIGRATIONS)
	outcome := databaseMigrationTestMigrate(conn, DATABASE_MIGRATIONS[:])
	assert(
		outcome == DatabaseMigrationOutcome{previousVersion = 0, version = newest, adopted = true},
		fmt.tprintf("expected the rc1 schema to be adopted, got %v", outcome),
	)
	databaseMigrationTestValidationPasses(conn)
	recorded := databaseMigrationTestRecorded(conn)
	expected := databaseMigrationTestExpectedRecorded()
	assert(
		recorded == expected,
		fmt.tprintf("expected schema_migrations to hold %q, got %q", expected, recorded),
	)
	after := databaseMigrationTestValue(conn, DATABASE_MIGRATION_TEST_FINGERPRINT_SQL)
	assert(
		after == before,
		fmt.tprintf("expected every rc1 row intact:\nbefore %q\nafter  %q", before, after),
	)

	// A second start changes nothing, not even applied_at.
	appliedAt := databaseMigrationTestValue(
		conn,
		"SELECT string_agg(applied_at::text, ',' ORDER BY version) FROM schema_migrations",
	)
	again := databaseMigrationTestMigrate(conn, DATABASE_MIGRATIONS[:])
	assert(
		again == DatabaseMigrationOutcome{previousVersion = newest, version = newest},
		fmt.tprintf("expected the second run to be a no-op, got %v", again),
	)
	appliedAtAgain := databaseMigrationTestValue(
		conn,
		"SELECT string_agg(applied_at::text, ',' ORDER BY version) FROM schema_migrations",
	)
	assert(appliedAtAgain == appliedAt, "expected the second run to leave schema_migrations alone")
	afterAgain := databaseMigrationTestValue(conn, DATABASE_MIGRATION_TEST_FINGERPRINT_SQL)
	assert(afterAgain == before, "expected the second run to leave every row intact")

	// The identity sequences carry on after the adopted rows.
	Insert :: struct {
		query:    string,
		expected: string,
	}
	inserts := [?]Insert {
		{"INSERT INTO users (nickname) VALUES ('mig-dave') RETURNING id::text", "4"},
		{"INSERT INTO server_roles (name) VALUES ('moderator') RETURNING id::text", "2"},
		{"INSERT INTO rooms (name) VALUES ('newroom') RETURNING id::text", "3"},
		{
			"INSERT INTO user_server_roles (user_id, role_id) VALUES (4, 2) " +
			"RETURNING user_id || ':' || role_id",
			"4:2",
		},
		{
			"INSERT INTO room_members (room_id, user_id) VALUES (3, 4) " +
			"RETURNING room_id || ':' || user_id",
			"3:4",
		},
		{
			"INSERT INTO chat_messages (room_id, sender_user_id, content) " +
			"VALUES (3, 4, 'after the upgrade') RETURNING id::text",
			"3",
		},
		{
			"INSERT INTO direct_messages (sender_user_id, recipient_user_id, content) " +
			"VALUES (4, 1, 'after the upgrade') RETURNING id::text",
			"3",
		},
	}
	for insert in inserts {
		id := databaseMigrationTestValue(conn, insert.query)
		assert(
			id == insert.expected,
			fmt.tprintf("expected %q to return %q, got %q", insert.query, insert.expected, id),
		)
	}
}

@(test)
testMigrationsAdoptProtocol7RoomsAgainstPostgreSQL :: proc(t: ^testing.T) {
	_ = t
	if os.get_env(DATABASE_SQL_TEST_ENV, context.temp_allocator) != "1" {
		return
	}
	conn, schema := databaseMigrationTestOpen("protocol7")
	defer databaseMigrationTestClose(conn, schema)

	// The rc1 schema with the protocol 7 rooms table, whose creator column is NOT NULL.
	databaseDefaultRoomTestExec(
		conn,
		"create protocol 7 schema",
		DATABASE_MIGRATION_TEST_RC1_CREATE_SQL +
		" ALTER TABLE rooms ALTER COLUMN created_by_user_id SET NOT NULL; " +
		"INSERT INTO users (nickname) VALUES ('mig-erin'); " +
		"INSERT INTO rooms (name, created_by_user_id) VALUES ('lobby', 1)",
	)
	nullableBefore := databaseMigrationTestValue(
		conn,
		"SELECT is_nullable FROM information_schema.columns WHERE table_schema = " +
		"current_schema() AND table_name = 'rooms' AND column_name = 'created_by_user_id'",
	)
	assert(nullableBefore == "NO", "expected the protocol 7 creator column to start NOT NULL")

	outcome := databaseMigrationTestMigrate(conn, DATABASE_MIGRATIONS[:])
	assert(
		outcome.adopted,
		fmt.tprintf("expected the protocol 7 schema to be adopted: %v", outcome),
	)
	databaseMigrationTestValidationPasses(conn)
	nullable := databaseMigrationTestValue(
		conn,
		"SELECT is_nullable FROM information_schema.columns WHERE table_schema = " +
		"current_schema() AND table_name = 'rooms' AND column_name = 'created_by_user_id'",
	)
	assert(nullable == "YES", fmt.tprintf("expected a nullable creator, got %q", nullable))
	rooms := databaseMigrationTestValue(
		conn,
		"SELECT string_agg(id || ':' || name || ':' || created_by_user_id, ',') FROM rooms",
	)
	assert(rooms == "1:lobby:1", fmt.tprintf("expected the protocol 7 room intact, got %q", rooms))
}

@(test)
testMigrationsRefuseNewerSchemaAgainstPostgreSQL :: proc(t: ^testing.T) {
	_ = t
	if os.get_env(DATABASE_SQL_TEST_ENV, context.temp_allocator) != "1" {
		return
	}
	conn, schema := databaseMigrationTestOpen("newer")
	defer databaseMigrationTestClose(conn, schema)

	databaseMigrationTestMigrate(conn, DATABASE_MIGRATIONS[:])
	databaseDefaultRoomTestExec(
		conn,
		"stamp a future version",
		"INSERT INTO users (nickname) VALUES ('mig-frank'); " +
		"INSERT INTO schema_migrations (version, name) VALUES (9999, 'from the future')",
	)
	before := databaseMigrationTestValue(conn, DATABASE_MIGRATION_TEST_FINGERPRINT_SQL)
	recordedBefore := databaseMigrationTestRecorded(conn)

	databaseMigrationTestRefuse(
		conn,
		DATABASE_MIGRATIONS[:],
		fmt.tprintf(
			"database schema version 9999 is newer than this server supports (%d)",
			len(DATABASE_MIGRATIONS),
		),
	)
	after := databaseMigrationTestValue(conn, DATABASE_MIGRATION_TEST_FINGERPRINT_SQL)
	recordedAfter := databaseMigrationTestRecorded(conn)
	assert(after == before, "expected a refused start to leave every row alone")
	assert(
		recordedAfter == recordedBefore,
		fmt.tprintf("expected schema_migrations unchanged, got %q", recordedAfter),
	)
}

@(test)
testMigrationsRefuseUnrecognisedSchemaAgainstPostgreSQL :: proc(t: ^testing.T) {
	_ = t
	if os.get_env(DATABASE_SQL_TEST_ENV, context.temp_allocator) != "1" {
		return
	}
	conn, schema := databaseMigrationTestOpen("unrecognised")
	defer databaseMigrationTestClose(conn, schema)

	// An rc1 schema whose chat_messages lost a column, with accounts in it.
	databaseDefaultRoomTestExec(
		conn,
		"create unrecognised schema",
		DATABASE_MIGRATION_TEST_RC1_CREATE_SQL,
	)
	databaseDefaultRoomTestExec(
		conn,
		"damage unrecognised schema",
		"ALTER TABLE chat_messages DROP COLUMN content; " +
		"INSERT INTO users (nickname) VALUES ('mig-grace'), ('mig-heidi')",
	)

	databaseMigrationTestRefuse(conn, DATABASE_MIGRATIONS[:], "chat_messages columns")
	users := databaseMigrationTestValue(
		conn,
		"SELECT string_agg(nickname, ',' ORDER BY id) FROM users",
	)
	assert(users == "mig-grace,mig-heidi", fmt.tprintf("expected the accounts kept, got %q", users))
	tables := databaseMigrationTestValue(
		conn,
		"SELECT (to_regclass('chat_messages') IS NOT NULL)::text || ':' || " +
		"(to_regclass('schema_migrations') IS NULL)::text || ':' || " +
		"(SELECT count(*) FROM information_schema.columns WHERE table_schema = " +
		"current_schema() AND table_name = 'chat_messages')",
	)
	assert(
		tables == "true:true:4",
		fmt.tprintf("expected chat_messages kept as it was and no version recorded: %q", tables),
	)
}

// Migration 1 plus test migrations, in the temp allocator.
databaseMigrationTestList :: proc(extra: ..DatabaseMigration) -> []DatabaseMigration {
	list := make([dynamic]DatabaseMigration, context.temp_allocator)
	append(&list, DATABASE_MIGRATIONS[0])
	append(&list, ..extra)
	return list[:]
}

@(test)
testMigrationsRollBackFailedMigrationAgainstPostgreSQL :: proc(t: ^testing.T) {
	_ = t
	if os.get_env(DATABASE_SQL_TEST_ENV, context.temp_allocator) != "1" {
		return
	}
	conn, schema := databaseMigrationTestOpen("failed")
	defer databaseMigrationTestClose(conn, schema)

	databaseMigrationTestMigrate(conn, databaseMigrationTestList())
	// Its first statements succeed and its last fails, so only a rollback undoes them.
	failing := databaseMigrationTestList(
		DatabaseMigration {
			version = 2,
			name = "half done",
			sql = "CREATE TABLE migration_probe (id INTEGER); " +
			"INSERT INTO migration_probe VALUES (1); " +
			"ALTER TABLE users ADD COLUMN probe TEXT; " +
			"SELECT 1 / 0",
		},
	)
	databaseMigrationTestRefuse(conn, failing, "database migration 2 (half done) failed")
	recorded := databaseMigrationTestRecorded(conn)
	assert(
		recorded == "1:baseline",
		fmt.tprintf("expected the version to stay 1, got %q", recorded),
	)
	leftovers := databaseMigrationTestValue(
		conn,
		"SELECT (to_regclass('migration_probe') IS NULL)::text || ':' || " +
		"(SELECT count(*) FROM information_schema.columns WHERE table_schema = " +
		"current_schema() AND table_name = 'users' AND column_name = 'probe')",
	)
	assert(
		leftovers == "true:0",
		fmt.tprintf("expected the failed migration rolled back entirely, got %q", leftovers),
	)
}

@(test)
testMigrationsApplyNewMigrationOnceAgainstPostgreSQL :: proc(t: ^testing.T) {
	_ = t
	if os.get_env(DATABASE_SQL_TEST_ENV, context.temp_allocator) != "1" {
		return
	}
	conn, schema := databaseMigrationTestOpen("applied")
	defer databaseMigrationTestClose(conn, schema)

	databaseMigrationTestMigrate(conn, databaseMigrationTestList())
	// Not idempotent on purpose: a second run of its SQL would fail or add a row.
	extended := databaseMigrationTestList(
		DatabaseMigration {
			version = 2,
			name = "probe table",
			sql = "CREATE TABLE migration_probe (id INTEGER); " +
			"INSERT INTO migration_probe VALUES (1)",
		},
	)
	outcome := databaseMigrationTestMigrate(conn, extended)
	assert(
		outcome == DatabaseMigrationOutcome{previousVersion = 1, version = 2},
		fmt.tprintf("expected migration 2 to apply on top of 1, got %v", outcome),
	)
	again := databaseMigrationTestMigrate(conn, extended)
	assert(
		again == DatabaseMigrationOutcome{previousVersion = 2, version = 2},
		fmt.tprintf("expected the second run to be a no-op, got %v", again),
	)
	recorded := databaseMigrationTestRecorded(conn)
	assert(
		recorded == "1:baseline,2:probe table",
		fmt.tprintf("expected both versions recorded, got %q", recorded),
	)
	rows := databaseMigrationTestValue(conn, "SELECT count(*)::text FROM migration_probe")
	assert(rows == "1", fmt.tprintf("expected migration 2 to run exactly once, got %q rows", rows))
}
