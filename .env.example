# HayChat server example environment configuration for local tester runs.
#
# Usage:
#   cp .env.example .env
#   set -a
#   . ./.env
#   set +a
#
# The values below match the supported Linux-first local tester flow.
# They are sufficient for the MVP bootstrap/start path when PostgreSQL is
# available locally with the default haychat role, password, and database.

# Required baseline values for the supported local MVP flow.
export HAYCHAT_DATABASE_URL=localhost
export HAYCHAT_DATABASE_PORT=5432
export HAYCHAT_DATABASE_USER=haychat
export HAYCHAT_DATABASE_PASS=haychat
export HAYCHAT_DATABASE_NAME=haychat

# Optional runtime overrides. These defaults already match the tester-safe
# local server behavior, but keeping them here avoids guesswork.
export HAYCHAT_WEB_ADMIN_PORT=8080
export HAYCHAT_LISTEN_ADDR=0.0.0.0
export HAYCHAT_LISTEN_PORT=12345
export HAYCHAT_LOG_LEVEL=info
export HAYCHAT_LOG_DIR=./logs
export HAYCHAT_FILE_STORAGE_PATH=./storage
export HAYCHAT_SERVER_IDENTITY_FILE=./storage/server_identity.json
export HAYCHAT_MAX_RESTARTS=5
export HAYCHAT_RESTART_BACKOFF_MIN=0.1
export HAYCHAT_RESTART_BACKOFF_MAX=10.0
export HAYCHAT_MAX_NETWORK_THREADS=4
export HAYCHAT_MAX_FILE_SIZE=10485760
export HAYCHAT_MAX_STORAGE_CAPACITY=1073741824

# Advanced identity overrides. Leave these unset for normal local tester runs.
# If both are omitted, the server loads or generates ./storage/server_identity.json.
# export HAYCHAT_SERVER_PRIVATE_KEY=
# export HAYCHAT_SERVER_PUBLIC_KEY=
