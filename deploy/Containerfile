# HayChat production server image.
#
# Build it from the repository root (the build context must be the root, so the build stage
# can reach dev/, common/, and server/):
#
#   podman build -f deploy/Containerfile -t haychat-server .
#
# or `./dev.sh release-image`. See deploy/README.md for running it.
#
# The build stage uses the same package script and Odin pins as the dev image and CI. The
# runtime stage holds only the server binary and the libraries it links. x86-64 (amd64) only:
# the link check below names the x86-64 loader.

# ── Build ─────────────────────────────────────────────────────────

FROM registry.fedoraproject.org/fedora:44 AS build

COPY dev/install-packages.sh dev/bootstrap-odin.sh /usr/local/lib/haychat/
RUN /usr/local/lib/haychat/install-packages.sh
RUN /usr/local/lib/haychat/bootstrap-odin.sh /opt/Odin

ENV ODIN_ROOT=/opt/Odin \
	PATH=/opt/Odin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin

WORKDIR /src
COPY common common
COPY server server
# `odin build` checks the server's test files too, and they #load these from outside server/
# (config_test.odin, database_attachments_test.odin). Keep this list, and .containerignore,
# in step with every #load("../...") under server/.
COPY .env.example ./
COPY docs/server-configuration.md docs/
COPY deploy/README.md deploy/
COPY deploy/sql/remove-attachment.sql deploy/sql/
RUN mkdir -p /out \
	&& odin build server -o:speed -out:/out/haychat-server \
	&& echo "Shared libraries the server links:" \
	&& objdump -p /out/haychat-server | grep NEEDED

# The notices and licence texts the server binary needs, from the toolchain that built it.
# The same table as the server release archive (deploy/release-artifacts.sh); it fails the
# build when one is missing. Copied after the build so editing the script keeps that layer.
COPY LICENSE THIRD_PARTY_NOTICES.md ./
COPY deploy/release-artifacts.sh deploy/
RUN deploy/release-artifacts.sh --stage-licences server /out/licenses

# ── Runtime ───────────────────────────────────────────────────────

FROM registry.fedoraproject.org/fedora-minimal:44

# The server's direct dependencies (objdump NEEDED above) are libpq.so.5 and libenet.so.7
# beside glibc; the packages pull in libpq's own dependencies (OpenSSL, Kerberos, LDAP).
RUN microdnf install -y --setopt=install_weak_deps=0 libpq enet \
	&& microdnf clean all \
	&& rm -rf /var/cache/libdnf5 /var/lib/dnf

# A fixed, non-root account. Named volumes copy the ownership of the directories below the
# first time they are mounted, so the server can write its logs and state.
RUN echo 'haychat:x:10001:10001:HayChat server:/var/lib/haychat:/sbin/nologin' >>/etc/passwd \
	&& echo 'haychat:x:10001:' >>/etc/group \
	&& mkdir -p /var/lib/haychat/logs /var/lib/haychat/storage /var/lib/haychat/attachments \
	&& chown -R 10001:10001 /var/lib/haychat \
	&& chmod 0700 /var/lib/haychat/storage /var/lib/haychat/attachments

COPY --from=build /out/haychat-server /usr/local/bin/haychat-server
COPY --from=build /out/licenses/ /usr/share/licenses/haychat-server/
COPY server/sql/auth_bootstrap.sql deploy/sql/make-admin.sql deploy/sql/create-invite.sql \
	deploy/sql/set-registration-mode.sql deploy/sql/attachment-usage.sql \
	deploy/sql/remove-attachment.sql /usr/share/haychat/sql/

# Fail the build when a linked library is missing from the runtime stage.
RUN ! /lib64/ld-linux-x86-64.so.2 --list /usr/local/bin/haychat-server | grep -F 'not found'

ENV HAYCHAT_LISTEN_ADDR=0.0.0.0 \
	HAYCHAT_LISTEN_PORT=12345 \
	HAYCHAT_LOG_DIR=/var/lib/haychat/logs \
	HAYCHAT_FILE_STORAGE_PATH=/var/lib/haychat/storage \
	HAYCHAT_SERVER_IDENTITY_FILE=/var/lib/haychat/storage/server_identity.json \
	HAYCHAT_ATTACHMENT_DIR=/var/lib/haychat/attachments

USER 10001:10001
WORKDIR /var/lib/haychat
VOLUME ["/var/lib/haychat/logs", "/var/lib/haychat/storage", "/var/lib/haychat/attachments"]
EXPOSE 12345/udp

# SIGINT is the server's graceful shutdown signal: it stops its worker processes first.
# (A HEALTHCHECK here would be dropped from OCI images; deploy/quadlet sets HealthCmd.)
STOPSIGNAL SIGINT

ENTRYPOINT ["/usr/local/bin/haychat-server"]

LABEL org.opencontainers.image.title="HayChat server" \
	org.opencontainers.image.description="Self-hosted chat server (encrypted ENet transport)" \
	org.opencontainers.image.source="https://git.spyingwind.com/quonic/haychat" \
	org.opencontainers.image.licenses="AGPL-3.0-only"
